+/* ------------------------------------------------------------------------ */
+/* AFLNet state machine (afl-fuzz.c, AFLNet section)                        */
+/* ------------------------------------------------------------------------ */
+
+static void setup_ipsm(void) {
+
+  ipsm = agopen("g", Agdirected, 0);
+  agattr(ipsm, AGNODE, "color", "black");
+  agattr(ipsm, AGEDGE, "color", "black");
+  khs_ipsm_paths = kh_init(hs32);
+  khms_states = kh_init(hms);
+
+}
+
+static u32 get_state_index(u32 state_id) {
+
+  u32 index = 0;
+  for (index = 0; index < state_ids_count; index++)
+    if (state_ids[index] == state_id) break;
+  return index;
+
+}
+
+static void expand_was_fuzzed_map(u32 new_states, u32 new_qentries) {
+
+  u32 i, j;
+  was_fuzzed_map = (char **)ck_realloc(
+      was_fuzzed_map, (fuzzed_map_states + new_states) * sizeof(char *));
+  for (i = fuzzed_map_states; i < fuzzed_map_states + new_states; i++)
+    was_fuzzed_map[i] = NULL;
+  for (i = 0; i < fuzzed_map_states + new_states; i++)
+    was_fuzzed_map[i] = (char *)ck_realloc(
+        was_fuzzed_map[i], (fuzzed_map_qentries + new_qentries) * sizeof(char));
+
+  for (i = 0; i < fuzzed_map_states + new_states; i++)
+    for (j = 0; j < fuzzed_map_qentries + new_qentries; j++)
+      if ((i >= fuzzed_map_states) || (j >= fuzzed_map_qentries))
+        was_fuzzed_map[i][j] = -1;
+
+  fuzzed_map_states += new_states;
+  fuzzed_map_qentries += new_qentries;
+
+}
+
+/* update_state_bitmap(): only the state sequence part; state feedback in the
+   bitmap (-b 2/3) is not ported (CODE_FEEDBACK, AFLNet's default). */
+static void update_state_sequence(void) {
+
+  if (state_sequence) {
+
+    ck_free(state_sequence);
+    state_sequence = NULL;
+
+  }
+
+  state_sequence = (*extract_response_codes)((u8 *)response_buf,
+                                             response_buf_size, &state_count);
+
+}
+
+static u8 is_state_sequence_interesting(unsigned int *seq, unsigned int cnt) {
+
+  u32 *trimmed = NULL;
+  u32  i, count = 0;
+  for (i = 0; i < cnt; i++) {
+
+    if ((i >= 2) && (seq[i] == seq[i - 1]) && (seq[i] == seq[i - 2])) continue;
+    count++;
+    trimmed = (u32 *)realloc(trimmed, count * sizeof(unsigned int));
+    trimmed[count - 1] = seq[i];
+
+  }
+
+  u32 hashKey = hash32((u8 *)trimmed, count * sizeof(unsigned int), 0);
+  if (trimmed) free(trimmed);
+
+  if (kh_get(hs32, khs_ipsm_paths, hashKey) != kh_end(khs_ipsm_paths)) {
+
+    return 0;
+
+  } else {
+
+    int dummy;
+    kh_put(hs32, khs_ipsm_paths, hashKey, &dummy);
+    return 1;
+
+  }
+
+}
+
+static void update_region_annotations(struct queue_entry *q) {
+
+  aflnet_qinfo_t *qi = QI(q);
+  u32             i;
+
+  for (i = 0; i < messages_sent && i < qi->region_count; i++) {
+
+    if ((response_bytes[i] == 0) ||
+        (i > 0 && (response_bytes[i] - response_bytes[i - 1] == 0))) {
+
+      qi->regions[i].state_sequence = NULL;
+      qi->regions[i].state_count = 0;
+
+    } else {
+
+      unsigned int cur_state_count;
+      qi->regions[i].state_sequence = (*extract_response_codes)(
+          (u8 *)response_buf, response_bytes[i], &cur_state_count);
+      qi->regions[i].state_count = cur_state_count;
+
+    }
+
+  }
+
+}
+
+static u8 *choose_source_region(afl_state_t *afl, u32 *out_len) {
+
+  u8                 *out = NULL;
+  struct queue_entry *q;
+  *out_len = 0;
+
+  q = afl->queue_buf[rand_below(afl, afl->queued_items)];
+  aflnet_qinfo_t *qi = QI(q);
+
+  if (qi->region_count) {
+
+    u32 reg_index = rand_below(afl, qi->region_count);
+    u32 len = qi->regions[reg_index].end_byte -
+              qi->regions[reg_index].start_byte + 1;
+    if (len <= MAX_FILE) {
+
+      out = (u8 *)ck_alloc(len);
+      *out_len = len;
+      FILE *fp = fopen((char *)q->fname, "rb");
+      if (!fp) PFATAL("Unable to open '%s'", q->fname);
+      fseek(fp, qi->regions[reg_index].start_byte, SEEK_CUR);
+      if (fread(out, 1, len, fp) != len) {
+
+        /* as in AFLNet: no error handling */
+
+      }
+
+      fclose(fp);
+
+    }
+
+  }
+
+  return out;
+
+}
+
+static void update_fuzzs(void) {
+
+  unsigned int    i;
+  int             discard;
+  khash_t(hs32) * khs_state_ids;
+  khint_t k;
+  khs_state_ids = kh_init(hs32);
+
+  for (i = 0; i < state_count; i++) {
+
+    unsigned int state_id = state_sequence[i];
+    if (kh_get(hs32, khs_state_ids, state_id) != kh_end(khs_state_ids)) {
+
+      continue;
+
+    } else {
+
+      kh_put(hs32, khs_state_ids, state_id, &discard);
+      k = kh_get(hms, khms_states, state_id);
+      if (k != kh_end(khms_states)) { kh_val(khms_states, k)->fuzzs++; }
+
+    }
+
+  }
+
+  kh_destroy(hs32, khs_state_ids);
+
+}
+
+static u32 index_search(u32 *A, u32 n, u32 val) {
+
+  u32 index = 0;
+  for (index = 0; index < n; index++)
+    if (val <= A[index]) break;
+  return index;
+
+}
+
+static u32 update_scores_and_select_next_state(afl_state_t *afl, u8 mode) {
+
+  u32 result = 0, i;
+  if (state_ids_count == 0) return 0;
+
+  u32 *state_scores = (u32 *)ck_alloc(state_ids_count * sizeof(u32));
+
+  khint_t       k;
+  state_info_t *state;
+  for (i = 0; i < state_ids_count; i++) {
+
+    u32 state_id = state_ids[i];
+    k = kh_get(hms, khms_states, state_id);
+    if (k != kh_end(khms_states)) {
+
+      state = kh_val(khms_states, k);
+      switch (mode) {
+
+        case FAVOR:
+          state->score = ceil(
+              1000 *
+              pow(2,
+                  -log10(log10(state->fuzzs + 1) * state->selected_times + 1)) *
+              pow(2, log(state->paths_discovered + 1)));
+          break;
+
+      }
+
+      if (i == 0) {
+
+        state_scores[i] = state->score;
+
+      } else {
+
+        state_scores[i] = state_scores[i - 1] + state->score;
+
+      }
+
+    }
+
+  }
+
+  /* AFLNet: UR(state_scores[last]) (UR(0) would divide by zero) */
+  u32 randV = state_scores[state_ids_count - 1]
+                  ? rand_below(afl, state_scores[state_ids_count - 1])
+                  : 0;
+  u32 idx = index_search(state_scores, state_ids_count, randV);
+  result = state_ids[idx];
+
+  ck_free(state_scores);
+  return result;
+
+}
+
+static unsigned int choose_target_state(afl_state_t *afl, u8 mode) {
+
+  u32 result = 0;
+
+  switch (mode) {
+
+    case RANDOM_SELECTION:
+      selected_state_index = rand_below(afl, state_ids_count);
+      result = state_ids[selected_state_index];
+      break;
+    case ROUND_ROBIN:
+      result = state_ids[selected_state_index];
+      selected_state_index++;
+      if (selected_state_index == state_ids_count) selected_state_index = 0;
+      break;
+    case FAVOR:
+      if (state_cycles < 5) {
+
+        result = state_ids[selected_state_index];
+        selected_state_index++;
+        if (selected_state_index == state_ids_count) {
+
+          selected_state_index = 0;
+          state_cycles++;
+
+        }
+
+        break;
+
+      }
+
+      result = update_scores_and_select_next_state(afl, FAVOR);
+      break;
+    default:
+      break;
+
+  }
+
+  return result;
+
+}
+
+static struct queue_entry *choose_seed(afl_state_t *afl, u32 tsid, u8 mode) {
+
+  khint_t             k;
+  state_info_t       *state;
+  struct queue_entry *result = NULL;
+
+  k = kh_get(hms, khms_states, tsid);
+  if (k != kh_end(khms_states)) {
+
+    state = kh_val(khms_states, k);
+
+    if (state->seeds_count == 0) return NULL;
+
+    switch (mode) {
+
+      case RANDOM_SELECTION:
+        state->selected_seed_index = rand_below(afl, state->seeds_count);
+        result = state->seeds[state->selected_seed_index];
+        break;
+      case ROUND_ROBIN:
+        result = state->seeds[state->selected_seed_index];
+        state->selected_seed_index++;
+        if (state->selected_seed_index == state->seeds_count)
+          state->selected_seed_index = 0;
+        break;
+      case FAVOR:
+        if (state->seeds_count > 10) {
+
+          u32 passed_cycles = 0;
+          while (passed_cycles < 5) {
+
+            result = state->seeds[state->selected_seed_index];
+            if (state->selected_seed_index + 1 == state->seeds_count) {
+
+              state->selected_seed_index = 0;
+              passed_cycles++;
+
+            } else
+
+              state->selected_seed_index++;
+
+            if (QI(result)->generating_state_id != tsid &&
+                !QI(result)->is_initial_seed && rand_below(afl, 100) < 90)
+              continue;
+
+            u32 target_state_index = get_state_index(tsid);
+            if (afl->pending_favored) {
+
+              if (((was_fuzzed_map[target_state_index][result->id] == 1) ||
+                   !result->favored) &&
+                  rand_below(afl, 100) < SKIP_TO_NEW_PROB)
+                continue;
+              break;
+
+            } else if (!result->favored && afl->queued_items > 10) {
+
+              if (afl->queue_cycle > 1 &&
+                  (was_fuzzed_map[target_state_index][result->id] == 0)) {
+
+                if (rand_below(afl, 100) < SKIP_NFAV_NEW_PROB) continue;
+
+              } else {
+
+                if (rand_below(afl, 100) < SKIP_NFAV_OLD_PROB) continue;
+
+              }
+
+              break;
+
+            }
+
+          }
+
+        } else {
+
+          result = state->seeds[state->selected_seed_index];
+          state->selected_seed_index++;
+          if (state->selected_seed_index == state->seeds_count)
+            state->selected_seed_index = 0;
+
+        }
+
+        break;
+      default:
+        break;
+
+    }
+
+  } else {
+
+    PFATAL("AFLNet - the states hashtable has no entries for state %d", tsid);
+
+  }
+
+  return result;
+
+}
+
+static state_info_t *new_state(u32 id) {
+
+  state_info_t *s = (state_info_t *)ck_alloc(sizeof(state_info_t));
+  s->id = id;
+  s->is_covered = 1;
+  s->score = 1;
+  return s;
+
+}
+
+static void update_state_aware_variables(afl_state_t *afl,
+                                         struct queue_entry *q, u8 dry_run) {
+
+  khint_t         k;
+  int             discard, i;
+  state_info_t   *state;
+  aflnet_qinfo_t *qi = QI(q);
+
+  if (!response_buf_size || !response_bytes) return;
+
+  if (is_state_sequence_interesting(state_sequence, state_count)) {
+
+    u8 *temp_str = state_sequence_to_string(state_sequence, state_count);
+    u8 *fname = alloc_printf("%s/replayable-new-ipsm-paths/id:%s:%s",
+                             afl->out_dir, temp_str,
+                             dry_run ? (u8 *)basename((char *)q->fname)
+                                     : (u8 *)"new");
+    save_kl_messages_to_file(kl_messages, fname, 1, messages_sent);
+    ck_free(temp_str);
+    ck_free(fname);
+
+    if (state_count > 1) {
+
+      unsigned int prevStateID = state_sequence[0];
+
+      for (i = 1; i < (int)state_count; i++) {
+
+        unsigned int curStateID = state_sequence[i];
+        char         fromState[STATE_STR_LEN], toState[STATE_STR_LEN];
+        snprintf(fromState, STATE_STR_LEN, "%d", prevStateID);
+        snprintf(toState, STATE_STR_LEN, "%d", curStateID);
+
+        Agnode_t *from, *to;
+        Agedge_t *edge;
+        from = agnode(ipsm, fromState, FALSE);
+        if (!from) {
+
+          from = agnode(ipsm, fromState, TRUE);
+          if (dry_run)
+            agset(from, "color", "blue");
+          else
+            agset(from, "color", "red");
+
+          k = kh_put(hms, khms_states, prevStateID, &discard);
+          kh_value(khms_states, k) = new_state(prevStateID);
+          state_ids =
+              (u32 *)ck_realloc(state_ids, (state_ids_count + 1) * sizeof(u32));
+          state_ids[state_ids_count++] = prevStateID;
+          if (prevStateID != 0) expand_was_fuzzed_map(1, 0);
+
+        }
+
+        to = agnode(ipsm, toState, FALSE);
+        if (!to) {
+
+          to = agnode(ipsm, toState, TRUE);
+          if (dry_run)
+            agset(to, "color", "blue");
+          else
+            agset(to, "color", "red");
+
+          k = kh_put(hms, khms_states, curStateID, &discard);
+          kh_value(khms_states, k) = new_state(curStateID);
+          state_ids =
+              (u32 *)ck_realloc(state_ids, (state_ids_count + 1) * sizeof(u32));
+          state_ids[state_ids_count++] = curStateID;
+          if (curStateID != 0) expand_was_fuzzed_map(1, 0);
+
+        }
+
+        edge = agedge(ipsm, from, to, NULL, FALSE);
+        if (!edge) {
+
+          edge = agedge(ipsm, from, to, "new_edge", TRUE);
+          if (dry_run)
+            agset(edge, "color", "blue");
+          else
+            agset(edge, "color", "red");
+
+        }
+
+        prevStateID = curStateID;
+
+      }
+
+    }
+
+    u8  *tmp = alloc_printf("%s/ipsm.dot", afl->out_dir);
+    FILE *f = fopen((char *)tmp, "w");
+    if (!f) PFATAL("Unable to create %s", tmp);
+    agwrite(ipsm, f);
+    fclose(f);
+    ck_free(tmp);
+
+  }
+
+  update_region_annotations(q);
+
+  k = kh_get(hms, khms_states, 0);
+  if (k != kh_end(khms_states)) {
+
+    state = kh_val(khms_states, k);
+    state->seeds =
+        (void **)ck_realloc(state->seeds, (state->seeds_count + 1) * sizeof(void *));
+    state->seeds[state->seeds_count] = (void *)q;
+    state->seeds_count++;
+    was_fuzzed_map[0][q->id] = 0;
+
+  } else {
+
+    PFATAL(
+        "AFLNet - the states hashtable should always contain an entry of the "
+        "initial state");
+
+  }
+
+  for (i = 0; i < (int)qi->region_count; i++) {
+
+    unsigned int regional_state_count = qi->regions[i].state_count;
+    if (regional_state_count > 0) {
+
+      unsigned int reachable_state_id =
+          qi->regions[i].state_sequence[regional_state_count - 1];
+
+      k = kh_get(hms, khms_states, reachable_state_id);
+      if (k != kh_end(khms_states)) {
+
+        state = kh_val(khms_states, k);
+        state->seeds = (void **)ck_realloc(
+            state->seeds, (state->seeds_count + 1) * sizeof(void *));
+        state->seeds[state->seeds_count] = (void *)q;
+        state->seeds_count++;
+
+      } else {
+
+        state_info_t *newState = new_state(reachable_state_id);
+        newState->seeds = (void **)ck_realloc(newState->seeds, sizeof(void *));
+        newState->seeds[0] = (void *)q;
+        newState->seeds_count = 1;
+        k = kh_put(hms, khms_states, reachable_state_id, &discard);
+        kh_value(khms_states, k) = newState;
+        state_ids =
+            (u32 *)ck_realloc(state_ids, (state_ids_count + 1) * sizeof(u32));
+        state_ids[state_ids_count++] = reachable_state_id;
+        if (reachable_state_id != 0) expand_was_fuzzed_map(1, 0);
+
+      }
+
+      was_fuzzed_map[get_state_index(reachable_state_id)][q->id] = 0;
+
+    }
+
+  }
+
+  khash_t(hs32) * khs_state_ids;
+  khs_state_ids = kh_init(hs32);
+
+  for (i = 0; i < (int)state_count; i++) {
+
+    unsigned int state_id = state_sequence[i];
+    if (kh_get(hs32, khs_state_ids, state_id) != kh_end(khs_state_ids)) {
+
+      continue;
+
+    } else {
+
+      kh_put(hs32, khs_state_ids, state_id, &discard);
+      k = kh_get(hms, khms_states, state_id);
+      if (k != kh_end(khms_states)) { kh_val(khms_states, k)->paths++; }
+
+    }
+
+  }
+
+  kh_destroy(hs32, khs_state_ids);
+
+  if (!dry_run) {
+
+    k = kh_get(hms, khms_states, target_state_id);
+    if (k != kh_end(khms_states)) {
+
+      kh_val(khms_states, k)->paths_discovered++;
+
+    }
+
+  }
+
+}
