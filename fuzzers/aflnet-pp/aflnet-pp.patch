+/* ------------------------------------------------------------------------ */
+/* kl_messages helpers (aflnet.c, unchanged)                                */
+/* ------------------------------------------------------------------------ */
+
+static klist_t(lms) * construct_kl_messages(u8 *fname, region_t *regions,
+                                            u32 region_count) {
+
+  FILE *fseed = fopen((char *)fname, "rb");
+  if (fseed == NULL) PFATAL("Cannot open seed file %s", fname);
+
+  klist_t(lms) *kl = kl_init(lms);
+  u32 i;
+
+  for (i = 0; i < region_count; i++) {
+
+    u32        len = regions[i].end_byte - regions[i].start_byte + 1;
+    message_t *m = (message_t *)ck_alloc(sizeof(message_t));
+    m->mdata = (char *)ck_alloc(len);
+    m->msize = len;
+    if (fread(m->mdata, 1, len, fseed) != len) {
+
+      /* AFLNet ignores short reads; keep the behaviour but avoid UB */
+
+    }
+
+    *kl_pushp(lms, kl) = m;
+
+  }
+
+  fclose(fseed);
+  return kl;
+
+}
+
+static void delete_kl_messages(klist_t(lms) * kl) {
+
+  message_t *m;
+  int        ret = kl_shift(lms, kl, &m);
+  while (ret == 0) {
+
+    if (m) {
+
+      ck_free(m->mdata);
+      ck_free(m);
+
+    }
+
+    ret = kl_shift(lms, kl, &m);
+
+  }
+
+  kl_destroy(lms, kl);
+
+}
+
+static kliter_t(lms) * get_last_message(klist_t(lms) * kl) {
+
+  kliter_t(lms) *it = kl_begin(kl);
+  while (kl_next(it) != kl_end(kl))
+    it = kl_next(it);
+  return it;
+
+}
+
+static region_t *convert_kl_messages_to_regions(klist_t(lms) * kl,
+                                                u32 *region_count_ref,
+                                                u32  max_count) {
+
+  region_t      *regions = NULL;
+  kliter_t(lms) *it;
+  u32            region_count = 1;
+  s32            cur_start = 0, cur_end = 0;
+
+  for (it = kl_begin(kl); it != kl_end(kl) && region_count <= max_count;
+       it = kl_next(it)) {
+
+    regions = (region_t *)ck_realloc(regions, region_count * sizeof(region_t));
+    cur_end = cur_start + kl_val(it)->msize - 1;
+    if (cur_end < 0) PFATAL("End_byte cannot be negative");
+    regions[region_count - 1].start_byte = cur_start;
+    regions[region_count - 1].end_byte = cur_end;
+    regions[region_count - 1].modifiable = 0;
+    regions[region_count - 1].state_sequence = NULL;
+    regions[region_count - 1].state_count = 0;
+    cur_start = cur_end + 1;
+    region_count++;
+
+  }
+
+  *region_count_ref = region_count - 1;
+  return regions;
+
+}
+
+/* Raw (replay_enabled = 0) or replayable ([u32 len][msg]) serialization of
+   the first max_count messages, as save_kl_messages_to_file in AFLNet. */
+static u8 *serialize_kl_messages(klist_t(lms) * kl, u8 replay_enabled,
+                                 u32 max_count, u32 *len_out) {
+
+  static u8     *mem = NULL;
+  static u32     mem_size = 0;
+  u32            len = 0, count = 0;
+  kliter_t(lms) *it;
+
+  for (it = kl_begin(kl); it != kl_end(kl) && count < max_count;
+       it = kl_next(it)) {
+
+    u32 need = len + kl_val(it)->msize + (replay_enabled ? 4 : 0);
+    if (need > mem_size) {
+
+      mem_size = need * 2;
+      mem = ck_realloc(mem, mem_size);
+
+    }
+
+    if (replay_enabled) {
+
+      u32 msize = kl_val(it)->msize;
+      memcpy(mem + len, &msize, 4);
+      len += 4;
+
+    }
+
+    memcpy(mem + len, kl_val(it)->mdata, kl_val(it)->msize);
+    len += kl_val(it)->msize;
+    count++;
+
+  }
+
+  *len_out = len;
+  return mem;
+
+}
+
+static void save_kl_messages_to_file(klist_t(lms) * kl, u8 *fname,
+                                     u8 replay_enabled, u32 max_count) {
+
+  u32 len;
+  u8 *mem = serialize_kl_messages(kl, replay_enabled, max_count, &len);
+  s32 fd = open((char *)fname, O_WRONLY | O_CREAT, 0600);
+  if (fd < 0) PFATAL("Unable to create file '%s'", fname);
+  ck_write(fd, mem, len, fname);
+  close(fd);
+
+}
+
+static u8 *state_sequence_to_string(unsigned int *stateSequence,
+                                    unsigned int  stateCount) {
+
+  u32    i = 0;
+  u8    *out = NULL;
+  char   strState[STATE_STR_LEN];
+  size_t len = 0;
+
+  for (i = 0; i < stateCount; i++) {
+
+    if ((i >= 2) && (stateSequence[i] == stateSequence[i - 1]) &&
+        (stateSequence[i] == stateSequence[i - 2]))
+      continue;
+    unsigned int stateID = stateSequence[i];
+    if (i == stateCount - 1) {
+
+      snprintf(strState, STATE_STR_LEN, "%d", (int)stateID);
+
+    } else {
+
+      snprintf(strState, STATE_STR_LEN, "%d-", (int)stateID);
+
+    }
+
+    out = (u8 *)ck_realloc(out, len + strlen(strState) + 1);
+    memcpy(&out[len], strState, strlen(strState) + 1);
+    len = strlen((char *)out);
+    if (len > 150 && (i + 1 < stateCount)) {
+
+      snprintf(strState, STATE_STR_LEN, "%s", "end-at-");
+      out = (u8 *)ck_realloc(out, len + strlen(strState) + 1);
+      memcpy(&out[len], strState, strlen(strState) + 1);
+      len = strlen((char *)out);
+      snprintf(strState, STATE_STR_LEN, "%d",
+               (int)stateSequence[stateCount - 1]);
+      out = (u8 *)ck_realloc(out, len + strlen(strState) + 1);
+      memcpy(&out[len], strState, strlen(strState) + 1);
+      len = strlen((char *)out);
+      break;
+
+    }
+
+  }
+
+  return out;
+
+}
+
+/* ------------------------------------------------------------------------ */
+/* In-process transport (same as AFLNet-real ipc://)                        */
+/* ------------------------------------------------------------------------ */
+
+#define IPC_OUTBOX_SIZE (1024 * 1024)
+#define IPC_DIR_INJECTED 0x02
+
+static s32  ipc_shm_id = -1;
+static u8  *ipc_outbox = NULL;
+static u32  ipc_max_frame = 0;
+static u32 *ipc_frame_owner = NULL;
+static u32  ipc_frame_count = 0;
+static u32  ipc_message_count = 0;
+static u8  *ipc_buf = NULL;
+static u32  ipc_buf_size = 0;
+
+static void ipc_remove_shm(void) {
+
+  if (ipc_shm_id >= 0) shmctl(ipc_shm_id, IPC_RMID, NULL);
+
+}
+
+static inline u32 rd_be32(const u8 *p) {
+
+  return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3];
+
+}
+
+static void ipc_append(const u8 *data, u32 n, u32 *len) {
+
+  if (*len + n > ipc_buf_size) {
+
+    ipc_buf_size = (*len + n) * 2;
+    ipc_buf = ck_realloc(ipc_buf, ipc_buf_size);
+
+  }
+
+  memcpy(ipc_buf + *len, data, n);
+  *len += n;
+
+}
+
+static void ipc_add_frame(const u8 *frame, u32 flen, u32 owner, u32 *len) {
+
+  if (ipc_max_frame && flen > ipc_max_frame) flen = ipc_max_frame;
+  if (!flen) return;
+
+  ipc_append(frame, flen, len);
+  ipc_append(delim, delim_len, len);
+
+  ipc_frame_owner =
+      ck_realloc(ipc_frame_owner, (ipc_frame_count + 1) * sizeof(u32));
+  ipc_frame_owner[ipc_frame_count++] = owner;
+
+}
+
+/* Split one message into frames exactly as the harness does and append them
+   with a canonical delimiter, so that every injected frame maps to the
+   message it came from. */
+static void ipc_add_message(const u8 *m, u32 msize, u32 owner, u32 *len) {
+
+  u32 cur = 0, start = 0;
+
+  while (cur + delim_len <= msize) {
+
+    if (!memcmp(m + cur, delim, delim_len)) {
+
+      ipc_add_frame(m + start, cur - start, owner, len);
+      cur += delim_len;
+      start = cur;
+
+    } else {
+
+      cur++;
+
+    }
+
+  }
+
+  if (start < msize) ipc_add_frame(m + start, msize - start, owner, len);
+
+}
+
+static void ipc_deliver(afl_forkserver_t *fsrv) {
+
+  kliter_t(lms) *it;
+  u32            len = 0;
+
+  ipc_frame_count = 0;
+  ipc_message_count = 0;
+
+  for (it = kl_begin(kl_messages); it != kl_end(kl_messages);
+       it = kl_next(it)) {
+
+    ipc_add_message((u8 *)kl_val(it)->mdata, kl_val(it)->msize,
+                    ipc_message_count, &len);
+    ipc_message_count++;
+
+  }
+
+  /* an empty test case is not executed by AFL++; use a lone delimiter */
+  if (!len) ipc_append(delim, delim_len, &len);
+
+  afl_fsrv_write_to_testcase(fsrv, ipc_buf, len);
+  memset(ipc_outbox, 0, 4);
+
+}
+
+static void ipc_collect(void) {
+
+  u32 total, cur = 0, inj = 0, filled = 0;
+  s32 open_msg = -1;
+
+  if (response_buf) {
+
+    ck_free(response_buf);
+    response_buf = NULL;
+
+  }
+
+  response_buf_size = 0;
+  if (response_bytes) {
+
+    ck_free(response_bytes);
+    response_bytes = NULL;
+
+  }
+
+  total = *(u32 *)ipc_outbox;
+  if (total > IPC_OUTBOX_SIZE - 4) total = IPC_OUTBOX_SIZE - 4;
+
+  response_buf = ck_alloc(total + 1);
+  memcpy(response_buf, ipc_outbox + 4, total);
+  response_buf_size = total;
+
+  response_bytes =
+      ck_alloc((ipc_message_count ? ipc_message_count : 1) * sizeof(u32));
+
+  while (cur + 6 <= total) {
+
+    u8  dir = (u8)response_buf[cur];
+    u32 len = rd_be32((u8 *)response_buf + cur + 2);
+    if (len > total - cur - 6) break;
+    if (dir == IPC_DIR_INJECTED && inj < ipc_frame_count) {
+
+      s32 owner = (s32)ipc_frame_owner[inj++];
+      if (owner != open_msg) {
+
+        while (filled < (u32)owner)
+          response_bytes[filled++] = cur;
+        open_msg = owner;
+
+      }
+
+    }
+
+    cur += 6 + len;
+
+  }
+
+  while (filled < ipc_message_count)
+    response_bytes[filled++] = cur;
+
+  messages_sent = (open_msg < 0) ? 1 : (u32)open_msg + 1;
+  if (messages_sent > ipc_message_count) messages_sent = ipc_message_count;
+  if (!messages_sent) messages_sent = 1;
+
+}
