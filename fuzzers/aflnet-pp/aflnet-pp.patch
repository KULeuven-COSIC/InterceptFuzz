+/* ------------------------------------------------------------------------ */
+/* Hooks                                                                    */
+/* ------------------------------------------------------------------------ */
+
+static u8 env_u8(const char *name, u8 def) {
+
+  char *v = getenv(name);
+  if (!v || !*v) return def;
+  return (u8)atoi(v);
+
+}
+
+void aflnet_setup(afl_state_t *afl) {
+
+  char *proto = getenv("AFLNET_PROTOCOL");
+  if (!proto || !*proto) return;
+
+  aflnet_enabled = 1;
+
+  if (!strcasecmp(proto, "DELIM")) {
+
+    char *d = getenv("AFLNET_DELIM");
+    if (d && *d) {
+
+      u32 n = strlen(d);
+      if (n % 2 || n / 2 > sizeof(delim) || !n)
+        FATAL("AFLNET_DELIM must be a hex string of 1-16 bytes");
+      for (u32 i = 0; i < n / 2; i++) {
+
+        unsigned int b;
+        if (sscanf(d + 2 * i, "%2x", &b) != 1) FATAL("Bad AFLNET_DELIM");
+        delim[i] = (u8)b;
+
+      }
+
+      delim_len = n / 2;
+
+    }
+
+    extract_requests = &extract_requests_delim;
+
+  } else {
+
+    FATAL("AFLNET_PROTOCOL must be DELIM");
+
+  }
+
+  extract_response_codes = &extract_response_codes_outbox;
+
+  state_aware_mode = env_u8("AFLNET_STATE_AWARE", 0);
+  region_level_mutation = env_u8("AFLNET_REGION_MUTATION", 0);
+  state_selection_algo = env_u8("AFLNET_STATE_SELECTION", ROUND_ROBIN);
+  seed_selection_algo = env_u8("AFLNET_SEED_SELECTION", RANDOM_SELECTION);
+  seed_schedule_type =
+      env_u8("AFLNET_SEED_SCHEDULE", state_aware_mode ? IPSM_SCHEDULE
+                                                      : QUEUE_SCHEDULE);
+  ipc_max_frame = getenv("AFLNET_IPC_MAX_FRAME")
+                      ? (u32)atoi(getenv("AFLNET_IPC_MAX_FRAME"))
+                      : 0;
+
+  if (state_selection_algo < RANDOM_SELECTION || state_selection_algo > FAVOR)
+    FATAL("Bad AFLNET_STATE_SELECTION");
+  if (seed_selection_algo < RANDOM_SELECTION || seed_selection_algo > FAVOR)
+    FATAL("Bad AFLNET_SEED_SELECTION");
+  if (seed_schedule_type == HYBRID_SCHEDULE)
+    FATAL("AFLNet's hybrid seed schedule (-h 3) is not ported");
+  if (seed_schedule_type != QUEUE_SCHEDULE &&
+      seed_schedule_type != IPSM_SCHEDULE)
+    FATAL("Bad AFLNET_SEED_SCHEDULE");
+  if (seed_schedule_type > QUEUE_SCHEDULE && !state_aware_mode)
+    FATAL("Seed schedule %d is only supported in state-aware mode",
+          seed_schedule_type);
+
+  aflnet_ipsm_sched =
+      state_aware_mode && seed_schedule_type == IPSM_SCHEDULE;
+
+  /* AFLNet removed trimming (queue entries must keep their regions) */
+  afl->disable_trim = 1;
+
+  /* outbox shared memory, inherited by the target through the environment */
+  ipc_shm_id =
+      shmget(IPC_PRIVATE, IPC_OUTBOX_SIZE, IPC_CREAT | IPC_EXCL | 0600);
+  if (ipc_shm_id < 0) PFATAL("AFLNet: shmget() for the outbox failed");
+  atexit(ipc_remove_shm);
+  u8 *id_str = alloc_printf("%d", ipc_shm_id);
+  setenv("OUTBOX_SHMEM_ID", (char *)id_str, 1);
+  ck_free(id_str);
+  ipc_outbox = shmat(ipc_shm_id, NULL, 0);
+  if (ipc_outbox == (void *)-1) PFATAL("AFLNet: shmat() failed");
+  memset(ipc_outbox, 0, 4);
+
+  setup_ipsm();
+
+  u8 *tmp = alloc_printf("%s/replayable-new-ipsm-paths", afl->out_dir);
+  if (mkdir((char *)tmp, 0700) && errno != EEXIST)
+    PFATAL("Unable to create '%s'", tmp);
+  ck_free(tmp);
+
+  OKF("AFLNet mode: framing=DELIM state_aware=%u region_mutation=%u "
+      "state_selection=%u seed_selection=%u schedule=%s",
+      state_aware_mode,
+      region_level_mutation, state_selection_algo, seed_selection_algo,
+      aflnet_ipsm_sched ? "IPSM" : "QUEUE");
+
+}
+
+void aflnet_check_options(afl_state_t *afl) {
+
+  if (!aflnet_enabled) return;
+
+  if (afl->shm.cmplog_mode)
+    FATAL("AFLNet mode does not support CmpLog (-c)");
+  if (afl->custom_mutators_count)
+    FATAL("AFLNet mode does not support custom mutators");
+  if (afl->limit_time_sig)
+    FATAL("AFLNet mode does not support MOpt (-L)");
+  /* AFL++ runs a single instance as "-S default" (as Concat does);
+     only explicit parallel setups are rejected */
+  if (afl->is_main_node ||
+      (afl->is_secondary_node && strcmp((char *)afl->sync_id, "default")))
+    FATAL("AFLNet mode does not support -M/-S");
+  if (afl->use_splicing)
+    FATAL("AFLNet mode does not support the splice stage (-u)");
+
+}
+
+void aflnet_set_corpus_read(u8 on) {
+
+  corpus_read_or_sync = on;
+
+}
+
+void aflnet_queue_entry_added(afl_state_t *afl, struct queue_entry *q) {
+
+  aflnet_qinfo_t *qi = QI(q);
+
+  qi->regions = NULL;
+  qi->region_count = 0;
+  qi->generating_state_id = target_state_id;
+  qi->is_initial_seed = 0;
+
+  if (corpus_read_or_sync) {
+
+    u8 *buf = ck_alloc(q->len ? q->len : 1);
+    s32 fd = open((char *)q->fname, O_RDONLY);
+    if (fd < 0) PFATAL("Unable to open '%s'", q->fname);
+    ck_read(fd, buf, q->len, q->fname);
+    close(fd);
+    qi->regions = (*extract_requests)(buf, q->len, &qi->region_count);
+    ck_free(buf);
+    if ((corpus_read_or_sync == 1) &&
+        (qi->region_count > max_seed_region_count))
+      max_seed_region_count = qi->region_count;
+
+  } else if (kl_messages) {
+
+    qi->regions =
+        convert_kl_messages_to_regions(kl_messages, &qi->region_count,
+                                       messages_sent);
+
+  }
+
+  if (fuzzed_map_states) {
+
+    expand_was_fuzzed_map(0, 1);
+
+  } else {
+
+    expand_was_fuzzed_map(1, 1);
+
+  }
+
+  (void)afl;
+
+}
+
+void aflnet_dry_run_pre(afl_state_t *afl, struct queue_entry *q) {
+
+  aflnet_qinfo_t *qi = QI(q);
+  qi->is_initial_seed = 1;
+  if (kl_messages) delete_kl_messages(kl_messages);
+  kl_messages = construct_kl_messages(q->fname, qi->regions, qi->region_count);
+  (void)afl;
+
+}
+
+void aflnet_dry_run_post(afl_state_t *afl, struct queue_entry *q) {
+
+  if (state_aware_mode) update_state_aware_variables(afl, q, 1);
+  if (kl_messages) {
+
+    delete_kl_messages(kl_messages);
+    kl_messages = NULL;
+
+  }
+
+}
+
+void aflnet_before_fuzzing(afl_state_t *afl) {
+
+  (void)afl;
+  if (aflnet_ipsm_sched && state_ids_count == 0)
+    PFATAL(
+        "No server states have been detected. Server responses are likely "
+        "empty!");
+
+}
+
+/* AFLNet's IPSM_SCHEDULE main loop: pick a target state, then a seed. */
+void aflnet_select_next(afl_state_t *afl) {
+
+  struct queue_entry *selected_seed = NULL;
+
+  while (!selected_seed || QI(selected_seed)->region_count == 0) {
+
+    target_state_id = choose_target_state(afl, state_selection_algo);
+
+    /* Update favorites based on the selected state (pending_favored
+       depends on the target state) */
+    afl->score_changed = 1;
+    cull_queue(afl);
+
+    khint_t k = kh_get(hms, khms_states, target_state_id);
+    if (k != kh_end(khms_states)) kh_val(khms_states, k)->selected_times++;
+
+    selected_seed = choose_seed(afl, target_state_id, seed_selection_algo);
+
+  }
+
+  afl->current_entry = selected_seed->id;
+  afl->queue_cur = selected_seed;
+
+}
+
+/* cull_queue(): AFLNet keeps initial seeds favored. */
+void aflnet_cull_queue_restore(afl_state_t *afl) {
+
+  for (u32 i = 0; i < afl->queued_items; i++)
+    if (QI(afl->queue_buf[i])->is_initial_seed)
+      afl->queue_buf[i]->favored = 1;
+
+}
+
+/* cull_queue(): AFLNet's state-aware pending_favored rule. */
+u8 aflnet_counts_as_pending(afl_state_t *afl, struct queue_entry *q) {
+
+  (void)afl;
+  if (state_aware_mode) {
+
+    aflnet_qinfo_t *qi = QI(q);
+    return (qi->generating_state_id == target_state_id ||
+            qi->is_initial_seed) &&
+           (was_fuzzed_map[get_state_index(target_state_id)][q->id] == 0);
+
+  }
+
+  return !q->was_fuzzed;
+
+}
+
+/* common_fuzz_stuff(): rebuild kl_messages from M1 + mutated M2 + M3. */
+void aflnet_update_messages(afl_state_t *afl, u8 *out_buf, u32 len) {
+
+  (void)afl;
+  if (!in_fuzz_one || !kl_messages) return;
+
+  u32       region_count = 0;
+  region_t *regions = (*extract_requests)(out_buf, len, &region_count);
+  if (!region_count) PFATAL("AFLNet Region count cannot be Zero");
+
+  u32 i;
+  kliter_t(lms) * prev_last_message, *cur_last_message;
+  prev_last_message = get_last_message(kl_messages);
+
+  for (i = 0; i < region_count; i++) {
+
+    u32 rlen;
+    if (i == max_seed_region_count) {
+
+      rlen = regions[region_count - 1].end_byte - regions[i].start_byte + 1;
+
+    } else {
+
+      rlen = regions[i].end_byte - regions[i].start_byte + 1;
+
+    }
+
+    message_t *m = (message_t *)ck_alloc(sizeof(message_t));
+    m->mdata = (char *)ck_alloc(rlen);
+    m->msize = rlen;
+    memcpy(m->mdata, &out_buf[regions[i].start_byte], rlen);
+
+    *kl_pushp(lms, kl_messages) = m;
+
+    if (M2_next->next == kl_end(kl_messages)) {
+
+      M2_next = kl_end(kl_messages);
+
+    }
+
+    if (i == max_seed_region_count) break;
+
+  }
+
+  ck_free(regions);
+
+  cur_last_message = get_last_message(kl_messages);
+
+  kliter_t(lms) * old_M2_start;
+  if (M2_prev == NULL) {
+
+    old_M2_start = kl_begin(kl_messages);
+    kl_begin(kl_messages) = kl_next(prev_last_message);
+    kl_next(cur_last_message) = M2_next;
+    kl_next(prev_last_message) = kl_end(kl_messages);
+
+  } else {
+
+    old_M2_start = kl_next(M2_prev);
+    kl_next(M2_prev) = kl_next(prev_last_message);
+    kl_next(cur_last_message) = M2_next;
+    kl_next(prev_last_message) = kl_end(kl_messages);
+
+  }
+
+  kliter_t(lms) * cur_it, *next_it;
+  cur_it = old_M2_start;
+  next_it = kl_next(cur_it);
+  do {
+
+    ck_free(kl_val(cur_it)->mdata);
+    ck_free(kl_val(cur_it));
+    kmp_free(lms, kl_messages->mp, cur_it);
+    --kl_messages->size;
+    cur_it = next_it;
+    next_it = kl_next(next_it);
+
+  } while (cur_it != M2_next);
+
+}
+
+/* common_fuzz_stuff(): after run_target */
+void aflnet_after_fuzz_exec(afl_state_t *afl) {
+
+  (void)afl;
+  if (in_fuzz_one && state_aware_mode) update_fuzzs();
+
+}
+
+void aflnet_pre_run(afl_state_t *afl, afl_forkserver_t *fsrv) {
+
+  if (fsrv != &afl->fsrv || !kl_messages) return;
+  ipc_deliver(fsrv);
+
+}
+
+void aflnet_post_run(afl_state_t *afl, afl_forkserver_t *fsrv) {
+
+  if (fsrv != &afl->fsrv || !kl_messages) return;
+  ipc_collect();
+  update_state_sequence();
+
+}
+
+/* save_if_interesting(): AFLNet saves the consumed messages of the whole
+   sequence, not the mutated M2 buffer. */
+u8 *aflnet_sequence_to_save(afl_state_t *afl, u32 *len) {
+
+  (void)afl;
+  if (!kl_messages) return NULL;
+  static u8 *copy = NULL;
+  static u32 copy_size = 0;
+  u8        *mem = serialize_kl_messages(kl_messages, 0, messages_sent, len);
+  if (!*len) return NULL;
+  /* private copy: the caller keeps using it while calibration re-runs the
+     target (and re-serializes) */
+  if (*len > copy_size) {
+
+    copy_size = *len;
+    copy = ck_realloc(copy, copy_size);
+
+  }
+
+  memcpy(copy, mem, *len);
+  return copy;
+
+}
+
+void aflnet_new_queue_entry(afl_state_t *afl, struct queue_entry *q) {
+
+  if (state_aware_mode) update_state_aware_variables(afl, q, 0);
+
+}
+
+/* fuzz_one(): select M1/M2/M3, build kl_messages and the M2 buffer.
+   Returns 1 if the entry has to be skipped (AFLNet's "return 1"). */
+u8 aflnet_fuzz_one_begin(afl_state_t *afl, u8 **in_buf, u32 *len) {
+
+  struct queue_entry *queue_cur = afl->queue_cur;
+  aflnet_qinfo_t     *qi = QI(queue_cur);
+  u32                 i;
+  u32                 M2_start_region_ID = 0, M2_region_count = 0;
+
+  if (state_aware_mode) {
+
+    u32 total_region = qi->region_count;
+    if (total_region == 0) PFATAL("0 region found for %s", queue_cur->fname);
+
+    if (target_state_id == 0) {
+
+      M2_start_region_ID = 0;
+      M2_region_count = 0;
+      for (i = 0; i < qi->region_count; i++) {
+
+        if (qi->regions[i].state_count != qi->regions[0].state_count) break;
+        M2_region_count++;
+
+      }
+
+    } else {
+
+      M2_start_region_ID = 0;
+      for (i = 0; i < qi->region_count; i++) {
+
+        u32 regionalStateCount = qi->regions[i].state_count;
+        if (regionalStateCount > 0) {
+
+          u32 reachableStateID =
+              qi->regions[i].state_sequence[regionalStateCount - 1];
+          M2_start_region_ID++;
+          if (reachableStateID == target_state_id) break;
+
+        } else {
+
+          return 1;
+
+        }
+
+      }
+
+      for (i = M2_start_region_ID; i < qi->region_count; i++) {
+
+        if (qi->regions[i].state_count !=
+            qi->regions[M2_start_region_ID].state_count)
+          break;
+        M2_region_count++;
+
+      }
+
+      if (M2_start_region_ID >= qi->region_count) return 1;
+
+    }
+
+  } else {
+
+    u32 total_region = qi->region_count;
+    if (total_region == 0) PFATAL("0 region found for %s", queue_cur->fname);
+    M2_start_region_ID = rand_below(afl, total_region);
+    M2_region_count = rand_below(afl, total_region - M2_start_region_ID);
+    if (M2_region_count == 0) M2_region_count++;
+
+  }
+
+  if (kl_messages) delete_kl_messages(kl_messages);
+  kl_messages =
+      construct_kl_messages(queue_cur->fname, qi->regions, qi->region_count);
+
+  kliter_t(lms) * it;
+  M2_prev = NULL;
+  M2_next = kl_end(kl_messages);
+
+  u32 count = 0;
+  for (it = kl_begin(kl_messages); it != kl_end(kl_messages);
+       it = kl_next(it)) {
+
+    if (count == M2_start_region_ID - 1) { M2_prev = it; }
+    if (count == M2_start_region_ID + M2_region_count) { M2_next = it; }
+    count++;
+
+  }
+
+  if (M2_prev == NULL) {
+
+    it = kl_begin(kl_messages);
+
+  } else {
+
+    it = kl_next(M2_prev);
+
+  }
+
+  u32 in_buf_size = 0;
+  if (m2_buf) {
+
+    ck_free(m2_buf);
+    m2_buf = NULL;
+
+  }
+
+  while (it != M2_next) {
+
+    m2_buf = (u8 *)ck_realloc(m2_buf, in_buf_size + kl_val(it)->msize);
+    memcpy(&m2_buf[in_buf_size], kl_val(it)->mdata, kl_val(it)->msize);
+    in_buf_size += kl_val(it)->msize;
+    it = kl_next(it);
+
+  }
+
+  if (!m2_buf) m2_buf = ck_alloc(1);   /* empty M2 (cannot happen with >= 1
+                                          region, kept for safety) */
+
+  /* AFL++'s per-entry deterministic-stage state (skipdet) is sized by the
+     input length of the first fuzz_one() of an entry. With AFLNet, M2 of
+     the same entry differs between target states, so the state is reset
+     when the M2 length changes (otherwise the maps would be overrun). */
+  struct skipdet_entry *sd = queue_cur->skipdet_e;
+  if (sd && (sd->skip_eff_map || sd->done_inf_map) &&
+      qi->det_len != in_buf_size) {
+
+    if (sd->skip_eff_map) ck_free(sd->skip_eff_map);
+    if (sd->done_inf_map) ck_free(sd->done_inf_map);
+    sd->skip_eff_map = NULL;
+    sd->done_inf_map = NULL;
+    sd->done_eff = 0;
+    sd->continue_inf = 0;
+    sd->quick_eff_bytes = 0;
+
+  }
+
+  qi->det_len = in_buf_size;
+
+  *in_buf = m2_buf;
+  *len = in_buf_size;
+  in_fuzz_one = 1;
+  return 0;
+
+}
+
+void aflnet_fuzz_one_end(afl_state_t *afl) {
+
+  /* AFLNet updates the per-state map together with was_fuzzed, i.e. only
+     the first time an entry is fully processed. This hook is called right
+     before AFL++ sets was_fuzzed, with the same condition. */
+  if (!afl->stop_soon && !afl->queue_cur->cal_failed &&
+      !afl->queue_cur->was_fuzzed && fuzzed_map_states) {
+
+    was_fuzzed_map[get_state_index(target_state_id)][afl->queue_cur->id] = 1;
+
+  }
+
+  in_fuzz_one = 0;
+  if (m2_buf) {
+
+    ck_free(m2_buf);
+    m2_buf = NULL;
+
+  }
+
+  if (kl_messages) {
+
+    delete_kl_messages(kl_messages);
+    kl_messages = NULL;
+
+  }
+
+}
+
+/* Havoc cases 17-20 of AFLNet. AFLNet draws UR(15 + 2 + 4) and uses cases
+   17..20 for region-level mutations, i.e. 4 out of 21 choices, each of the
+   four with equal probability. Returns 1 if a region-level mutation was
+   drawn (applied or not, as in AFLNet where a failed case is a no-op). */
+u8 aflnet_region_havoc(afl_state_t *afl, u8 **out_buf_p, u32 *temp_len) {
+
+  if (!region_level_mutation) return 0;
+
+  u32 r = rand_below(afl, 21);
+  if (r < 17) return 0;
+
+  u8 *out_buf = *out_buf_p;
+
+  switch (r) {
+
+    case 17: {      /* Replace the current region with a random region */
+
+      u32 src_len = 0;
+      u8 *src = choose_source_region(afl, &src_len);
+      if (src == NULL) break;
+      out_buf = afl_realloc(AFL_BUF_PARAM(out), src_len);
+      if (unlikely(!out_buf)) PFATAL("alloc");
+      memcpy(out_buf, src, src_len);
+      *temp_len = src_len;
+      ck_free(src);
+      break;
+
+    }
+
+    case 18:        /* Insert a random region at the beginning */
+    case 19: {      /* Insert a random region at the end */
+
+      u32 src_len = 0;
+      u8 *src = choose_source_region(afl, &src_len);
+      if (src == NULL) break;
+      if (*temp_len + src_len >= MAX_FILE) {
+
+        ck_free(src);
+        break;
+
+      }
+
+      u8 *new_buf =
+          afl_realloc(AFL_BUF_PARAM(out_scratch), *temp_len + src_len);
+      if (unlikely(!new_buf)) PFATAL("alloc");
+      if (r == 18) {
+
+        memcpy(new_buf, src, src_len);
+        memcpy(new_buf + src_len, out_buf, *temp_len);
+
+      } else {
+
+        memcpy(new_buf, out_buf, *temp_len);
+        memcpy(new_buf + *temp_len, src, src_len);
+
+      }
+
+      ck_free(src);
+      out_buf = new_buf;
+      afl_swap_bufs(AFL_BUF_PARAM(out), AFL_BUF_PARAM(out_scratch));
+      *temp_len += src_len;
+      break;
+
+    }
+
+    case 20: {      /* Duplicate the current region */
+
+      if (*temp_len * 2 >= MAX_FILE) break;
+      out_buf = afl_realloc(AFL_BUF_PARAM(out), *temp_len * 2);
+      if (unlikely(!out_buf)) PFATAL("alloc");
+      memcpy(out_buf + *temp_len, out_buf, *temp_len);
+      *temp_len += *temp_len;
+      break;
+
+    }
+
+  }
+
+  *out_buf_p = out_buf;
+  return 1;
+
+}
