diff --git a/include/aflnet-pp.h b/include/aflnet-pp.h
new file mode 100644
index 00000000..db69556f
--- /dev/null
+++ b/include/aflnet-pp.h
@@ -0,0 +1,74 @@
+/*
+   AFLNet on AFL++ ("AFLNet-pp") - public hooks
+   ---------------------------------------------
+
+   Port of the AFLNet algorithm (https://github.com/aflnet/aflnet, commit
+   96032f8, Apache-2.0) onto the AFL++ fuzzing engine. AFL++ provides the
+   engine (mutation operators, deterministic stages, power schedules,
+   instrumentation); the AFLNet parts (message regions, M1/M2/M3, IPSM state
+   machine, state/seed selection, region-level mutations) are ported as in
+   AFLNet. See src/afl-fuzz-aflnet.c and fuzzers/aflnet-pp/README.md.
+
+   Everything is configured through environment variables (AFLNet's command
+   line letters collide with AFL++ options):
+
+     AFLNET_PROTOCOL         DELIM                   (enables AFLNet mode)
+     AFLNET_DELIM            delimiter in hex        (default: DEAD)
+     AFLNET_STATE_AWARE      1 = AFLNet -E
+     AFLNET_REGION_MUTATION  1 = AFLNet -R
+     AFLNET_STATE_SELECTION  AFLNet -q (1 random, 2 round robin, 3 favor)
+     AFLNET_SEED_SELECTION   AFLNet -s (1 random, 2 round robin, 3 favor)
+     AFLNET_SEED_SCHEDULE    AFLNet -h (1 queue, 2 IPSM; default 2 if
+                             state aware, 1 otherwise)
+     AFLNET_IPC_MAX_FRAME    cap each injected frame to N bytes (0 = no cap)
+
+   Transport: in-process only (the AFLNet "-N ipc://" transport, see
+   fuzzers/aflnet-real/README.md); AFLNet's socket transport is not ported.
+*/
+
+#ifndef _AFLNET_PP_H
+#define _AFLNET_PP_H
+
+#include "types.h"
+
+struct afl_state;
+struct queue_entry;
+struct afl_forkserver;
+
+extern u8 aflnet_enabled;     /* AFLNET_PROTOCOL set                       */
+extern u8 aflnet_ipsm_sched;  /* state aware + IPSM seed schedule          */
+extern u8 aflnet_state_aware; /* AFLNet -E                                 */
+
+/* setup / teardown (afl-fuzz.c) */
+void aflnet_setup(struct afl_state *afl);
+void aflnet_check_options(struct afl_state *afl);
+void aflnet_set_corpus_read(u8 on);
+void aflnet_before_fuzzing(struct afl_state *afl);
+void aflnet_select_next(struct afl_state *afl);
+
+/* queue (afl-fuzz-queue.c) */
+void aflnet_queue_entry_added(struct afl_state *afl, struct queue_entry *q);
+void aflnet_cull_queue_restore(struct afl_state *afl);
+u8   aflnet_counts_as_pending(struct afl_state *afl, struct queue_entry *q);
+
+/* dry run (afl-fuzz-init.c) */
+void aflnet_dry_run_pre(struct afl_state *afl, struct queue_entry *q);
+void aflnet_dry_run_post(struct afl_state *afl, struct queue_entry *q);
+
+/* execution (afl-fuzz-run.c) */
+void aflnet_update_messages(struct afl_state *afl, u8 *buf, u32 len);
+void aflnet_after_fuzz_exec(struct afl_state *afl);
+void aflnet_pre_run(struct afl_state *afl, struct afl_forkserver *fsrv);
+void aflnet_post_run(struct afl_state *afl, struct afl_forkserver *fsrv);
+
+/* saving (afl-fuzz-bitmap.c) */
+u8  *aflnet_sequence_to_save(struct afl_state *afl, u32 *len);
+void aflnet_new_queue_entry(struct afl_state *afl, struct queue_entry *q);
+
+/* fuzz_one (afl-fuzz-one.c) */
+u8   aflnet_fuzz_one_begin(struct afl_state *afl, u8 **in_buf, u32 *len);
+void aflnet_fuzz_one_end(struct afl_state *afl);
+u8   aflnet_region_havoc(struct afl_state *afl, u8 **out_buf, u32 *temp_len);
+
+#endif
+
