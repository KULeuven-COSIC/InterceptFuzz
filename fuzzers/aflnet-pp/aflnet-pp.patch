+   EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
+   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+   NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS
+   BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN
+   ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+   CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+   SOFTWARE.
+*/
+
+#ifndef _AC_KLIST_H
+#define _AC_KLIST_H
+
+#include <stdlib.h>
+
+#ifndef klib_unused
+#if (defined __clang__ && __clang_major__ >= 3) || (defined __GNUC__ && __GNUC__ >= 3)
+#define klib_unused __attribute__ ((__unused__))
+#else
+#define klib_unused
+#endif
+#endif /* klib_unused */
+
+#define KMEMPOOL_INIT2(SCOPE, name, kmptype_t, kmpfree_f)				\
+	typedef struct {													\
+		size_t cnt, n, max;												\
+		kmptype_t **buf;												\
+	} kmp_##name##_t;													\
+	SCOPE kmp_##name##_t *kmp_init_##name(void) {						\
+		return calloc(1, sizeof(kmp_##name##_t));						\
+	}																	\
+	SCOPE void kmp_destroy_##name(kmp_##name##_t *mp) {					\
+		size_t k;														\
+		for (k = 0; k < mp->n; ++k) {									\
+			kmpfree_f(mp->buf[k]); free(mp->buf[k]);					\
+		}																\
+		free(mp->buf); free(mp);										\
+	}																	\
+	SCOPE kmptype_t *kmp_alloc_##name(kmp_##name##_t *mp) {				\
+		++mp->cnt;														\
+		if (mp->n == 0) return calloc(1, sizeof(kmptype_t));			\
+		return mp->buf[--mp->n];										\
+	}																	\
+	SCOPE void kmp_free_##name(kmp_##name##_t *mp, kmptype_t *p) {		\
+		--mp->cnt;														\
+		if (mp->n == mp->max) {											\
+			mp->max = mp->max? mp->max<<1 : 16;							\
+			mp->buf = realloc(mp->buf, sizeof(kmptype_t *) * mp->max);	\
+		}																\
+		mp->buf[mp->n++] = p;											\
+	}
+
+#define KMEMPOOL_INIT(name, kmptype_t, kmpfree_f)						\
+	KMEMPOOL_INIT2(static inline klib_unused, name, kmptype_t, kmpfree_f)
+
+#define kmempool_t(name) kmp_##name##_t
+#define kmp_init(name) kmp_init_##name()
+#define kmp_destroy(name, mp) kmp_destroy_##name(mp)
+#define kmp_alloc(name, mp) kmp_alloc_##name(mp)
+#define kmp_free(name, mp, p) kmp_free_##name(mp, p)
+
+#define KLIST_INIT2(SCOPE, name, kltype_t, kmpfree_t)					\
+	struct __kl1_##name {												\
+		kltype_t data;													\
+		struct __kl1_##name *next;										\
+	};																	\
+	typedef struct __kl1_##name kl1_##name;								\
+	KMEMPOOL_INIT2(SCOPE, name, kl1_##name, kmpfree_t)					\
+	typedef struct {													\
+		kl1_##name *head, *tail;										\
+		kmp_##name##_t *mp;												\
+		size_t size;													\
+	} kl_##name##_t;													\
+	SCOPE kl_##name##_t *kl_init_##name(void) {							\
+		kl_##name##_t *kl = calloc(1, sizeof(kl_##name##_t));			\
+		kl->mp = kmp_init(name);										\
+		kl->head = kl->tail = kmp_alloc(name, kl->mp);					\
+		kl->head->next = 0;												\
+		return kl;														\
+	}																	\
+	SCOPE void kl_destroy_##name(kl_##name##_t *kl) {					\
+		kl1_##name *p;													\
+		for (p = kl->head; p != kl->tail; p = p->next)					\
+			kmp_free(name, kl->mp, p);									\
+		kmp_free(name, kl->mp, p);										\
+		kmp_destroy(name, kl->mp);										\
+		free(kl);														\
+	}																	\
+	SCOPE kltype_t *kl_pushp_##name(kl_##name##_t *kl) {				\
+		kl1_##name *q, *p = kmp_alloc(name, kl->mp);					\
+		q = kl->tail; p->next = 0; kl->tail->next = p; kl->tail = p;	\
+		++kl->size;														\
+		return &q->data;												\
+	}																	\
+	SCOPE int kl_shift_##name(kl_##name##_t *kl, kltype_t *d) {			\
+		kl1_##name *p;													\
+		if (kl->head->next == 0) return -1;								\
+		--kl->size;														\
+		p = kl->head; kl->head = kl->head->next;						\
+		if (d) *d = p->data;											\
+		kmp_free(name, kl->mp, p);										\
+		return 0;														\
+	}
+
+#define KLIST_INIT(name, kltype_t, kmpfree_t)							\
+	KLIST_INIT2(static inline klib_unused, name, kltype_t, kmpfree_t)
+
+#define kliter_t(name) kl1_##name
+#define klist_t(name) kl_##name##_t
+#define kl_val(iter) ((iter)->data)
+#define kl_next(iter) ((iter)->next)
+#define kl_begin(kl) ((kl)->head)
+#define kl_end(kl) ((kl)->tail)
+
+#define kl_init(name) kl_init_##name()
+#define kl_destroy(name, kl) kl_destroy_##name(kl)
+#define kl_pushp(name, kl) kl_pushp_##name(kl)
+#define kl_shift(name, kl, d) kl_shift_##name(kl, d)
+
+#endif
diff --git a/src/afl-fuzz-aflnet.c b/src/afl-fuzz-aflnet.c
new file mode 100644
index 00000000..79441dff
--- /dev/null
+++ b/src/afl-fuzz-aflnet.c
@@ -0,0 +1,1852 @@
+/*
+   AFLNet on AFL++ ("AFLNet-pp")
+   -----------------------------
+
+   Port of AFLNet (https://github.com/aflnet/aflnet, commit 96032f8,
+   Copyright 2019-2020 Van-Thuan Pham et al., Apache-2.0) onto AFL++.
+
+   Porting rule: AFL++ is the engine (mutation operators, deterministic
+   stages, energy/power schedule, instrumentation). Everything AFLNet changed
+   in AFL 2.56b is reproduced as in AFLNet, nothing is added:
+
+     - messages/regions per queue entry, kl_messages, M1/M2/M3 (only M2 is
+       mutated, the sequence is rebuilt in common_fuzz_stuff)
+     - IPSM state machine, state selection (-q), seed selection (-s), the
+       per-state was_fuzzed map, paths/fuzzs/selected_times bookkeeping
+     - region-level havoc mutations (-R, 4 of 21 havoc choices)
+     - max_seed_region_count, only consumed messages are saved
+     - initial seeds stay favored, state-aware pending_favored
+     - AFLNet's removals: no trimming, no calibration retry in fuzz_one
+
+   Not ported (documented omissions): the socket transport (replaced by the
+   in-process "ipc://" transport also used by AFLNet-real), state feedback
+   in the bitmap (-b 2/3), the hybrid seed schedule (-h 3), sync (-M/-S),
+   AFLNet's debug outputs (regions/, replayable-queue/).
+
+   Functions below keep AFLNet's names and bodies where possible; changes
+   are limited to the AFL++ API (afl_state_t, queue_buf, rand_below, ...).
+*/
+
+#include "afl-fuzz.h"
+#include "khash.h"
+#include "klist.h"
+
+#include <graphviz/gvc.h>
+#include <math.h>
+#include <sys/ipc.h>
+#include <sys/shm.h>
+
+#ifndef STATE_STR_LEN
+  #define STATE_STR_LEN 12
+#endif
+
+/* ------------------------------------------------------------------------ */
+/* AFLNet data structures (aflnet.h)                                        */
+/* ------------------------------------------------------------------------ */
+
+typedef struct {
+
+  int           start_byte;
+  int           end_byte;
+  char          modifiable;
+  unsigned int *state_sequence;
+  unsigned int  state_count;
+
+} region_t;
+
+typedef struct {
+
+  char *mdata;
+  int   msize;
+
+} message_t;
+
+typedef struct {
+
+  u32    id;
+  u8     is_covered;
+  u32    paths;
+  u32    paths_discovered;
+  u32    selected_times;
+  u32    fuzzs;
+  u32    score;
+  u32    selected_seed_index;
+  void **seeds;
+  u32    seeds_count;
+
+} state_info_t;
+
+enum { INVALID_SELECTION, RANDOM_SELECTION, ROUND_ROBIN, FAVOR };
+enum { INVALID_SCHEDULE, QUEUE_SCHEDULE, IPSM_SCHEDULE, HYBRID_SCHEDULE };
+
+#define message_t_freer(x)
+KLIST_INIT(lms, message_t *, message_t_freer)
+KHASH_SET_INIT_INT(hs32)
+KHASH_INIT(hms, khint32_t, state_info_t *, 1, kh_int_hash_func,
+           kh_int_hash_equal)
+
+/* AFLNet-specific per-queue-entry data, kept outside struct queue_entry so
+   that AFL++'s structure stays untouched. Indexed by queue_entry->id, which
+   equals AFLNet's q->index. */
+typedef struct {
+
+  region_t *regions;
+  u32       region_count;
+  u32       generating_state_id;
+  u8        is_initial_seed;
+  u32       det_len;          /* M2 length the skipdet maps were built for */
+
+} aflnet_qinfo_t;
+
+static aflnet_qinfo_t *qinfo = NULL;
+static u32             qinfo_count = 0;
+
+static aflnet_qinfo_t *QI(struct queue_entry *q) {
+
+  if (q->id >= qinfo_count) {
+
+    u32 n = q->id + 1;
+    qinfo = ck_realloc(qinfo, n * sizeof(aflnet_qinfo_t));
+    memset(&qinfo[qinfo_count], 0, (n - qinfo_count) * sizeof(aflnet_qinfo_t));
+    qinfo_count = n;
+
+  }
+
+  return &qinfo[q->id];
+
+}
+
+/* ------------------------------------------------------------------------ */
+/* AFLNet global state (afl-fuzz.c)                                         */
+/* ------------------------------------------------------------------------ */
+
+u8 aflnet_enabled = 0;
+u8 aflnet_ipsm_sched = 0;
+
+u8 aflnet_state_aware = 0;
+#define state_aware_mode aflnet_state_aware
+static u8 region_level_mutation = 0;
+static u8 state_selection_algo = ROUND_ROBIN,
+          seed_selection_algo = RANDOM_SELECTION;
+static u8 seed_schedule_type = IPSM_SCHEDULE;
+static u8 corpus_read_or_sync = 0;
+
+static char *response_buf = NULL;
+static int   response_buf_size = 0;
+static u32  *response_bytes = NULL;
+static u32   target_state_id = 0;
+static u32  *state_ids = NULL;
+static u32   state_ids_count = 0;
+static u32   selected_state_index = 0;
+static u32   state_cycles = 0;
+static u32   messages_sent = 0;
+static char **was_fuzzed_map = NULL;
+static u32   fuzzed_map_states = 0;
+static u32   fuzzed_map_qentries = 0;
+static u32   max_seed_region_count = 0;
+static u32  *state_sequence = NULL;
+static u32   state_count = 0;
+
+static Agraph_t *ipsm;
+
+static klist_t(lms) * kl_messages = NULL;
+static khash_t(hs32) * khs_ipsm_paths;
+static khash_t(hms) * khms_states;
+static kliter_t(lms) * M2_prev, *M2_next;
+
+static unsigned int *(*extract_response_codes)(unsigned char *buf,
+                                               unsigned int  buf_size,
+                                               unsigned int *state_count_ref);
+static region_t *(*extract_requests)(unsigned char *buf, unsigned int buf_size,
+                                     unsigned int *region_count_ref);
+
+/* fuzz_one context */
+static u8  in_fuzz_one = 0;
+static u8 *m2_buf = NULL;
+
+/* ------------------------------------------------------------------------ */
+/* Protocol parsers                                                          */
+/* ------------------------------------------------------------------------ */
+
+static u8  delim[16] = {0xDE, 0xAD};
+static u32 delim_len = 2;
+
+/* DELIM: a message is everything up to and including the delimiter (like
+   AFLNet's text protocols, e.g. RTSP regions end with "\r\n\r\n"). A
+   remainder without delimiter is the last region. */
+static region_t *extract_requests_delim(unsigned char *buf,
+                                        unsigned int   buf_size,
+                                        unsigned int  *region_count_ref) {
+
+  region_t    *regions = NULL;
+  unsigned int region_count = 0, start = 0, i = 0;
+
+  while (i + delim_len <= buf_size) {
+
+    if (!memcmp(buf + i, delim, delim_len)) {
+
+      unsigned int end = i + delim_len - 1;
+      regions = ck_realloc(regions, (region_count + 1) * sizeof(region_t));
+      regions[region_count].start_byte = start;
+      regions[region_count].end_byte = end;
+      regions[region_count].modifiable = 0;
+      regions[region_count].state_sequence = NULL;
+      regions[region_count].state_count = 0;
+      region_count++;
+      start = end + 1;
+      i = start;
+
+    } else {
+
+      i++;
+
+    }
+
+  }
+
+  if (start < buf_size || !region_count) {
+
+    regions = ck_realloc(regions, (region_count + 1) * sizeof(region_t));
+    regions[region_count].start_byte = start;
+    regions[region_count].end_byte = buf_size ? buf_size - 1 : 0;
+    regions[region_count].modifiable = 0;
+    regions[region_count].state_sequence = NULL;
+    regions[region_count].state_count = 0;
+    region_count++;
+
+  }
+
+  *region_count_ref = region_count;
+  return regions;
+
+}
+
+/* States: identical to extract_response_codes_outbox in AFLNet-real. */
+static unsigned int *extract_response_codes_outbox(
+    unsigned char *buf, unsigned int buf_size, unsigned int *state_count_ref) {
+
+  unsigned int *seq = NULL;
+  unsigned int  n = 0, cur = 0;
+
+  seq = ck_realloc(seq, sizeof(unsigned int));
+  seq[n++] = 0;
+
+  while (cur + 6 <= buf_size) {
+
+    unsigned int len = ((unsigned int)buf[cur + 2] << 24) |
+                       ((unsigned int)buf[cur + 3] << 16) |
+                       ((unsigned int)buf[cur + 4] << 8) |
+                       (unsigned int)buf[cur + 5];
+    if (len > buf_size - cur - 6) break;
+    if (buf[cur] == 0x01) {
+
+      seq = ck_realloc(seq, (n + 1) * sizeof(unsigned int));
+      seq[n++] = (unsigned int)buf[cur + 1] + 1;
+
+    }
+
+    cur += 6 + len;
+
+  }
+
+  *state_count_ref = n;
+  return seq;
+
+}
