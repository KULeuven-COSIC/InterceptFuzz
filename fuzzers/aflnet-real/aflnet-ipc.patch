+/* ===================================================================== */
+/* AFLNet-IPC: length-prefixed frames + outbox state codes               */
+/* (-P THREAD / THREAD_LENPREFIX; meant to be used with -N ipc://)       */
+/* ===================================================================== */
+
+/* Requests (-P THREAD_LENPREFIX): the seed / queue file is a sequence of
+   [u32 BE len][frame].
+   Each region includes its 4-byte header so that region-level mutations
+   (which copy whole regions between seeds) keep the framing intact.
+   A length that overruns the buffer turns the rest into one region; a
+   trailing remainder of fewer than 4 bytes is attached to the last region.
+   The transport re-frames every message before execution, so a region does
+   not need to be well-formed. */
+region_t* extract_requests_lenprefix(unsigned char* buf, unsigned int buf_size, unsigned int* region_count_ref)
+{
+  region_t *regions = NULL;
+  unsigned int region_count = 0;
+  unsigned int cur = 0;
+
+  while (cur + 4 <= buf_size) {
+    unsigned int len = ((unsigned int)buf[cur] << 24) | ((unsigned int)buf[cur + 1] << 16) |
+                       ((unsigned int)buf[cur + 2] << 8) | (unsigned int)buf[cur + 3];
+    unsigned int end;
+
+    if (len > buf_size - cur - 4) end = buf_size - 1;
+    else end = cur + 4 + len - 1;
+
+    region_count++;
+    regions = (region_t *)ck_realloc(regions, region_count * sizeof(region_t));
+    regions[region_count - 1].start_byte = cur;
+    regions[region_count - 1].end_byte = end;
+    regions[region_count - 1].state_sequence = NULL;
+    regions[region_count - 1].state_count = 0;
+
+    cur = end + 1;
+  }
+
+  if (cur < buf_size) {
+    if (region_count) {
+      regions[region_count - 1].end_byte = buf_size - 1;
+    } else {
+      /* Fewer than 4 bytes: a single region (AFLNet requires at least one) */
+      region_count = 1;
+      regions = (region_t *)ck_realloc(regions, sizeof(region_t));
+      regions[0].start_byte = 0;
+      regions[0].end_byte = buf_size - 1;
+      regions[0].state_sequence = NULL;
+      regions[0].state_count = 0;
+    }
+  }
+
+  *region_count_ref = region_count;
+  return regions;
+}
+
+/* Requests (-P THREAD): the seed / queue file is { [frame] DE AD }*, the
+   input format of Concat. A region is everything up to and including
+   the delimiter (the same pattern as AFLNet's text protocols, e.g. RTSP
+   regions end with "\r\n\r\n"); a remainder without delimiter is the last
+   region. */
+region_t* extract_requests_delim(unsigned char* buf, unsigned int buf_size, unsigned int* region_count_ref)
+{
+  region_t *regions = NULL;
+  unsigned int region_count = 0, start = 0, i = 0;
+
+  while (i + 2 <= buf_size) {
+    if (buf[i] == 0xDE && buf[i + 1] == 0xAD) {
+      unsigned int end = i + 1;
+      region_count++;
+      regions = (region_t *)ck_realloc(regions, region_count * sizeof(region_t));
+      regions[region_count - 1].start_byte = start;
+      regions[region_count - 1].modifiable = 0;
+      regions[region_count - 1].end_byte = end;
+      regions[region_count - 1].state_sequence = NULL;
+      regions[region_count - 1].state_count = 0;
+      start = end + 1;
+      i = start;
+    } else i++;
+  }
+
+  if (start < buf_size || !region_count) {
+    region_count++;
+    regions = (region_t *)ck_realloc(regions, region_count * sizeof(region_t));
+    regions[region_count - 1].start_byte = start;
+    regions[region_count - 1].modifiable = 0;
+    regions[region_count - 1].end_byte = buf_size ? buf_size - 1 : 0;
+    regions[region_count - 1].state_sequence = NULL;
+    regions[region_count - 1].state_count = 0;
+  }
+
+  *region_count_ref = region_count;
+  return regions;
+}
+
+/* Responses: buf is the outbox body written by the target,
+   { [u8 dir][u8 type][u32 BE len][payload] }*. Every entry with dir 0x01
+   (output of the stack under test) contributes its type byte as a state.
+   States are shifted by one because AFLNet reserves 0 for the initial
+   state, while 0 is a valid type (e.g. MLE Link Request). */
+unsigned int* extract_response_codes_outbox(unsigned char* buf, unsigned int buf_size, unsigned int* state_count_ref)
+{
+  unsigned int *state_sequence = NULL;
+  unsigned int state_count = 0;
+  unsigned int cur = 0;
+
+  state_count++;
+  state_sequence = (unsigned int *)ck_realloc(state_sequence, state_count * sizeof(unsigned int));
+  state_sequence[state_count - 1] = 0;
+
+  while (cur + 6 <= buf_size) {
+    unsigned int len = ((unsigned int)buf[cur + 2] << 24) | ((unsigned int)buf[cur + 3] << 16) |
+                       ((unsigned int)buf[cur + 4] << 8) | (unsigned int)buf[cur + 5];
+    if (len > buf_size - cur - 6) break;
+
+    if (buf[cur] == 0x01) {
+      state_count++;
+      state_sequence = (unsigned int *)ck_realloc(state_sequence, state_count * sizeof(unsigned int));
+      state_sequence[state_count - 1] = (unsigned int)buf[cur + 1] + 1;
+    }
+
+    cur += 6 + len;
+  }
+
+  *state_count_ref = state_count;
+  return state_sequence;
+}
