+/* ===================================================================== */
+/* AFLNet-IPC: in-process / simulated targets (-N ipc://)                */
+/* ===================================================================== */
+/*
+   Instead of talking to a server over a socket *after* it has been spawned,
+   the whole message sequence is written to the test case file *before* the
+   target runs, and the target's reactions are read back from a shared-memory
+   "outbox" *after* it terminated. Everything downstream of the transport
+   (state extraction, IPSM, region annotations, M1/M2/M3 selection, region
+   level mutations) is untouched: ipc_collect() fills response_buf,
+   response_bytes[] and messages_sent exactly like send_over_network() does.
+
+   Test case format written for the target, depending on -P:
+     -P THREAD (default, same input format as Concat / AFLNet-pp):
+       { [frame] DE AD }*
+       Each AFLNet message (region) ends with the 0xDEAD delimiter. Every
+       message is split on the delimiter exactly as the harness does and
+       re-emitted with a canonical delimiter, so every injected frame maps
+       to the message it came from (see ipc_normalize_message_delim()).
+     -P THREAD_LENPREFIX (all integers big-endian):
+       [u32 total_len] { [u32 frame_len][frame] }*
+       Each AFLNet message (region) is itself stored as [u32 BE len][frame];
+       the header is re-computed here so that havoc on the length bytes
+       cannot desynchronise the rest of the sequence (see
+       ipc_normalize_message()).
+
+   Outbox format (written by the target, see OUTBOX_SHMEM_ID):
+       [u32 native total_bytes] { [u8 dir][u8 type][u32 BE len][payload] }*
+       dir 0x00: observed request (ignored by the transport)
+       dir 0x01: response / output of the stack under test
+       dir 0x02: frame injected from the test case (one per frame, in order)
+   response_buf is the outbox body (without the 4-byte total), so protocol
+   parsers (extract_response_codes_*) see the raw entry stream.
+
+   Environment:
+       AFLNET_IPC_MAX_FRAME   cap each frame to N bytes (default: no cap)
+*/
+
+#define IPC_OUTBOX_SIZE   (1024 * 1024)
+#define IPC_DIR_REQUEST   0x00
+#define IPC_DIR_RESPONSE  0x01
+#define IPC_DIR_INJECTED  0x02
+
+u8   use_ipc = 0;
+static s32  ipc_shm_id = -1;
+static u8*  ipc_outbox = NULL;
+static u32  ipc_max_frame = 0;
+static u32* ipc_frame_owner = NULL;  /* frame index -> kl_messages index */
+static u32  ipc_frame_count = 0;
+static u32  ipc_message_count = 0;
+static u8   ipc_framing_delim = 0;   /* -P THREAD: 0xDEAD-delimited frames */
+static const u8 ipc_delim[2] = {0xDE, 0xAD};
+
+static void ipc_remove_shm(void) {
+  if (ipc_shm_id >= 0) shmctl(ipc_shm_id, IPC_RMID, NULL);
+}
+
+static void ipc_setup(void) {
+
+  u8* tmp = getenv("AFLNET_IPC_MAX_FRAME");
+  if (tmp) ipc_max_frame = atoi(tmp);
+
+  ipc_shm_id = shmget(IPC_PRIVATE, IPC_OUTBOX_SIZE, IPC_CREAT | IPC_EXCL | 0600);
+  if (ipc_shm_id < 0) PFATAL("AFLNet-IPC: shmget() for the outbox failed");
+
+  atexit(ipc_remove_shm);
+
+  u8* id_str = alloc_printf("%d", ipc_shm_id);
+  setenv("OUTBOX_SHMEM_ID", id_str, 1);
+  ck_free(id_str);
+
+  ipc_outbox = shmat(ipc_shm_id, NULL, 0);
+  if (ipc_outbox == (void *)-1) PFATAL("AFLNet-IPC: shmat() for the outbox failed");
+
+  memset(ipc_outbox, 0, 4);
+
+}
+
+static inline u32 ipc_read_be32(const u8* p) {
+  return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | (u32)p[3];
+}
+
+static inline void ipc_write_be32(u8* p, u32 v) {
+  p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v;
+}
+
+/* Append the frames contained in one message to buf. A message normally is a
+   single [u32 BE len][frame]; it may contain several (AFLNet merges the tail
+   of long seeds into one message, see max_seed_region_count). A length that
+   overruns the message means "rest of the message"; fewer than 4 bytes are
+   taken verbatim as a frame. Empty frames are dropped (the harness ignores
+   them, so they would break the frame <-> injection mapping). */
+static void ipc_normalize_message(const u8* m, u32 msize, u32 owner,
+                                  u8** buf, u32* len) {
+
+  u32 cur = 0;
+
+  while (cur < msize) {
+
+    const u8* frame;
+    u32 flen;
+
+    if (msize - cur < 4) {
+      frame = m + cur;
+      flen  = msize - cur;
+      cur   = msize;
+    } else {
+      u32 l = ipc_read_be32(m + cur);
+      cur  += 4;
+      if (l > msize - cur) l = msize - cur;
+      frame = m + cur;
+      flen  = l;
+      cur  += l;
+    }
+
+    if (ipc_max_frame && flen > ipc_max_frame) flen = ipc_max_frame;
+    if (!flen) continue;
+
+    *buf = ck_realloc(*buf, *len + 4 + flen);
+    ipc_write_be32(*buf + *len, flen);
+    memcpy(*buf + *len + 4, frame, flen);
+    *len += 4 + flen;
+
+    ipc_frame_owner = ck_realloc(ipc_frame_owner, (ipc_frame_count + 1) * sizeof(u32));
+    ipc_frame_owner[ipc_frame_count++] = owner;
+
+  }
+
+}
+
+/* -P THREAD: append the frames of one message, each followed by the 0xDEAD
+   delimiter. The message is split on the delimiter exactly like the harness
+   splits the test case (empty frames are dropped there, so they are dropped
+   here as well to keep the frame <-> injection mapping). */
+static void ipc_add_frame_delim(const u8* frame, u32 flen, u32 owner,
+                                u8** buf, u32* len) {
+
+  if (ipc_max_frame && flen > ipc_max_frame) flen = ipc_max_frame;
+  if (!flen) return;
+
+  *buf = ck_realloc(*buf, *len + flen + sizeof(ipc_delim));
+  memcpy(*buf + *len, frame, flen);
+  memcpy(*buf + *len + flen, ipc_delim, sizeof(ipc_delim));
+  *len += flen + sizeof(ipc_delim);
+
+  ipc_frame_owner = ck_realloc(ipc_frame_owner, (ipc_frame_count + 1) * sizeof(u32));
+  ipc_frame_owner[ipc_frame_count++] = owner;
+
+}
+
+static void ipc_normalize_message_delim(const u8* m, u32 msize, u32 owner,
+                                        u8** buf, u32* len) {
+
+  u32 cur = 0, start = 0;
+
+  while (cur + sizeof(ipc_delim) <= msize) {
+    if (!memcmp(m + cur, ipc_delim, sizeof(ipc_delim))) {
+      ipc_add_frame_delim(m + start, cur - start, owner, buf, len);
+      cur  += sizeof(ipc_delim);
+      start = cur;
+    } else cur++;
+  }
+
+  if (start < msize) ipc_add_frame_delim(m + start, msize - start, owner, buf, len);
+
+}
+
+/* Write the current kl_messages to the test case; called before the target
+   is spawned. */
+static void ipc_deliver(void) {
+
+  kliter_t(lms) *it;
+  u32 hdr = ipc_framing_delim ? 0 : 4;
+  u8* buf = ck_alloc(4);
+  u32 len = hdr;
+
+  ipc_frame_count   = 0;
+  ipc_message_count = 0;
+
+  for (it = kl_begin(kl_messages); it != kl_end(kl_messages); it = kl_next(it)) {
+    if (ipc_framing_delim)
+      ipc_normalize_message_delim((u8*)kl_val(it)->mdata, kl_val(it)->msize,
+                                  ipc_message_count, &buf, &len);
+    else
+      ipc_normalize_message((u8*)kl_val(it)->mdata, kl_val(it)->msize,
+                            ipc_message_count, &buf, &len);
+    ipc_message_count++;
+  }
+
+  if (ipc_framing_delim) {
+    /* Never write an empty test case; a lone delimiter injects nothing. */
+    if (!len) { memcpy(buf, ipc_delim, sizeof(ipc_delim)); len = sizeof(ipc_delim); }
+  } else ipc_write_be32(buf, len - 4);
+
+  /* Same as AFL's original write_to_testcase() */
+  s32 fd = out_fd;
+
+  if (out_file) {
+    unlink(out_file); /* Ignore errors. */
+    fd = open(out_file, O_WRONLY | O_CREAT | O_EXCL, 0600);
+    if (fd < 0) PFATAL("Unable to create '%s'", out_file);
+  } else lseek(fd, 0, SEEK_SET);
+
+  ck_write(fd, buf, len, out_file);
+
+  if (!out_file) {
+    if (ftruncate(fd, len)) PFATAL("ftruncate() failed");
+    lseek(fd, 0, SEEK_SET);
+  } else close(fd);
+
+  ck_free(buf);
+
+  /* The target also resets it, but do not rely on that (e.g. early crash). */
+  memset(ipc_outbox, 0, 4);
+
+}
+
+/* Read the outbox after the target terminated and rebuild the state that
+   send_over_network() would have produced. */
+static void ipc_collect(void) {
+
+  u32 total, cur = 0, inj = 0, filled = 0;
+  s32 open_msg = -1;
+
+  if (response_buf) { ck_free(response_buf); response_buf = NULL; }
+  response_buf_size = 0;
+  if (response_bytes) { ck_free(response_bytes); response_bytes = NULL; }
+
+  total = *(u32*)ipc_outbox;
+  if (total > IPC_OUTBOX_SIZE - 4) total = IPC_OUTBOX_SIZE - 4;
+
+  response_buf = ck_alloc(total + 1);
+  memcpy(response_buf, ipc_outbox + 4, total);
+  response_buf_size = total;
+
+  response_bytes = ck_alloc((ipc_message_count ? ipc_message_count : 1) * sizeof(u32));
+
+  /* response_bytes[k] is cumulative (as with sockets): everything observed
+     before the first injected frame of the next consumed message. Messages
+     without frames get the same value as their predecessor, i.e. no
+     responses of their own. */
+  while (cur + 6 <= total) {
+
+    u8  dir = (u8)response_buf[cur];
+    u32 len = ipc_read_be32((u8*)response_buf + cur + 2);
+
+    if (len > total - cur - 6) break;
+
+    if (dir == IPC_DIR_INJECTED && inj < ipc_frame_count) {
+      s32 owner = (s32)ipc_frame_owner[inj++];
+      if (owner != open_msg) {
+        while (filled < (u32)owner) response_bytes[filled++] = cur;
+        open_msg = owner;
+      }
+    }
+
+    cur += 6 + len;
+
+  }
+
+  /* The last consumed message gets everything up to the end of the run;
+     messages that were never consumed get no responses of their own. */
+  while (filled < ipc_message_count) response_bytes[filled++] = cur;
+
+  /* Messages the target never consumed count as not sent (like a failed
+     send()): they are neither annotated nor saved. Keep at least one so
+     that a saved seed is never empty. */
+  messages_sent = (open_msg < 0) ? 1 : (u32)open_msg + 1;
+  if (messages_sent > ipc_message_count) messages_sent = ipc_message_count;
+  if (!messages_sent) messages_sent = 1;
+
+}
+/* End of AFLNet-IPC */
+
