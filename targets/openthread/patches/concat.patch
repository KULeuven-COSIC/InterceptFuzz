new file mode 100644
index 000000000..5993d64f4
--- /dev/null
+++ b/tests/fuzz/fuzz_test_form_join.cpp
@@ -0,0 +1,125 @@
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <iostream>
+#include <vector>
+#include <unistd.h>
+#include <sys/shm.h>
+#include <algorithm>
+
+#include "platform/nexus_core.hpp"
+#include "platform/nexus_node.hpp"
+
+// =========================================================================
+// THE "IN-PROCESS BRAIN" STATE
+// =========================================================================
+std::vector<std::vector<uint8_t>> g_input_queue;
+size_t g_input_index = 0;
+
+// =========================================================================
+// PHASE 3: THE INJECTOR 
+// =========================================================================
+
+extern "C" size_t libafl_process(uint8_t* buf, size_t buf_len, size_t max_len) {
+    // 1. ACTION (INJECTION): Replace OpenThread's buffer with our mutated packet
+    if (g_input_index < g_input_queue.size()) {
+        const auto& packet = g_input_queue[g_input_index];
+        size_t copy_len = std::min(packet.size(), max_len);
+        memcpy(buf, packet.data(), copy_len);
+        
+        g_input_index++;
+        return copy_len;
+    } 
+
+    // If queue is empty, let the target use its original packet
+    return buf_len; 
+}
+
+// =========================================================================
+// THE OPENTHREAD TARGET
+// =========================================================================
+
+namespace ot {
+namespace Nexus {
+
+size_t MaliciousNodeID_g = 0;
+bool AllNodesMalicious_g = false;
+
+void TestFormJoin(void)
+{
+    Core nexus;
+    Node &leader  = nexus.CreateNode();
+    Node &fed     = nexus.CreateNode();
+
+    // Assign roles for the external hooks to use
+#ifdef MALICIOUS_LEADER
+    MaliciousNodeID_g = leader.GetId(); // Let the Leader mutate the packets
+    AllNodesMalicious_g = false;
+#elif defined(MALICIOUS_FED)
+    MaliciousNodeID_g = fed.GetId(); // Let the Fed mutate the packets
+    AllNodesMalicious_g = false;
+#elif defined(MALICIOUS_BOTH)
+    #warning "Treating both nodes as malicious."
+    AllNodesMalicious_g = true;
+#else
+    #error "Please define one of MALICIOUS_LEADER, MALICIOUS_FED, or MALICIOUS_BOTH to specify which node(s) should be malicious."
+#endif
+
+    nexus.AdvanceTime(0);
+
+    leader.Form();
+    nexus.AdvanceTime(13 * 1000);
+
+    fed.Join(leader, Node::kAsFed);
+    nexus.AdvanceTime(5 * 1000);
+}
+
+} 
+} 
+
+// =========================================================================
+// LLVM LIBFUZZER API ENTRY POINTS
+// =========================================================================
+
+extern "C" int LLVMFuzzerInitialize(int *argc, char ***argv) {
+    return 0;
+}
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
+
+    srand(0U);
+
+    // 1. Reset state 
+    g_input_queue.clear();
+    g_input_index = 0;
+
+    const uint8_t delim[] = {0xDE, 0xAD};
+    size_t start = 0;
+
+    // 1. Split data using the delimiter and insert it into the g_input_queue
+    for (size_t i = 0; i < size; ++i) 
+    {
+        // Ensure we don't read out of bounds when checking for the 2-byte delimiter
+        if (i + 1 < size && data[i] == delim[0] && data[i + 1] == delim[1]) 
+        {
+            // Only add to the queue if the chunk is larger than 0 bytes
+            if (i > start) {
+                g_input_queue.emplace_back(data + start, data + i);
+            }
+            
+            i += 1;          // Skip the second byte of the delimiter (the loop adds +1 too)
+            start = i + 1;   // The next chunk starts immediately after the delimiter
+        }
+    }
+
+    // Capture any remaining payload after the final delimiter
+    if (start < size) 
+    {
+        g_input_queue.emplace_back(data + start, data + size);
+    }
+
+    // 3. Execute the target sequence
+    ot::Nexus::TestFormJoin();
+
+    return 0;
+}
