diff --git a/tests/fuzz/fuzz_parser_configuration.h b/tests/fuzz/fuzz_parser_configuration.h
new file mode 100644
index 000000000..836fb7408
--- /dev/null
+++ b/tests/fuzz/fuzz_parser_configuration.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <iostream>
+#include <vector>
+#include <cstdint>
+
+enum class Endian { Big, Little };
+
+// Toggle whether the payload includes a total length prefix at the very beginning
+constexpr bool HAS_TOTAL_LEN_PREFIX = true;
+
+// Define the byte-sizes by setting the underlying integer types.
+// Change to uint16_t (2 bytes), uint8_t (1 byte), or uint64_t (8 bytes) as needed.
+using TotalLenType = uint32_t; 
+using PktLenType   = uint32_t; 
+
+// Set the endianness of the incoming fuzzer payload
+constexpr Endian ENCODING = Endian::Big;
+
+// =========================================================================
+// TEMPLATED READER FUNCTION
+// =========================================================================
+// This single function automatically adapts to the byte-size of the type (T) 
+// and the chosen endianness without any runtime overhead.
+template <typename T, Endian E = ENCODING>
+inline T read_len(const uint8_t* buf) {
+    T result = 0;
+    if constexpr (E == Endian::Big) {
+        for (size_t i = 0; i < sizeof(T); ++i) {
+            result = (result << 8) | buf[i];
+        }
+    } else {
+        for (size_t i = 0; i < sizeof(T); ++i) {
+            result |= (static_cast<T>(buf[i]) << (i * 8));
+        }
+    }
+    return result;
+}
