diff --git a/tests/fuzz/fuzz_test_form_join.cpp b/tests/fuzz/fuzz_test_form_join.cpp
new file mode 100644
index 000000000..db93f0e52
--- /dev/null
+++ b/tests/fuzz/fuzz_test_form_join.cpp
@@ -0,0 +1,210 @@
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <iostream>
+#include <vector>
+#include <unistd.h>
+#include <sys/shm.h>
+#include <algorithm>
+
+#include "platform/nexus_core.hpp"
+#include "platform/nexus_node.hpp"
+
+#include "platform/thread_dissector.hpp"
+
+#include "fuzz_parser_configuration.h"
+
+// =========================================================================
+// THE "IN-PROCESS BRAIN" STATE
+// =========================================================================
+std::vector<std::vector<uint8_t>> g_input_queue;
+size_t g_input_index = 0;
+
+uint8_t* g_outbox_ptr = nullptr;
+const size_t OUTBOX_CAPACITY = 1024 * 1024; // 1MB
+
+// =========================================================================
+// PHASE 1: IPC ATTACHMENT
+// =========================================================================
+
+void setup_outbox() {
+    if (g_outbox_ptr != nullptr) return; 
+
+    const char* shm_id_str = getenv("OUTBOX_SHMEM_ID");
+    if (shm_id_str) {
+        int shm_id = atoi(shm_id_str);
+        g_outbox_ptr = (uint8_t*)shmat(shm_id, NULL, 0);
+    }
+}
+
+// =========================================================================
+// PHASE 2: THE REVERSE IPC (TRACE WRITER)
+// =========================================================================
+extern "C" void write_trace_to_outbox(uint8_t direction, uint8_t packet_type, const uint8_t* packet, size_t len) {
+    if (!g_outbox_ptr) {
+        return;
+    }
+
+    uint32_t* total_bytes_ptr = (uint32_t*)g_outbox_ptr;
+    uint32_t current_offset = *total_bytes_ptr;
+
+    // Header size is now 6 bytes: [1b Dir] + [1b Type] + [4b Length]
+    if (4 + current_offset + 6 + len <= OUTBOX_CAPACITY) {
+        uint8_t* write_ptr = g_outbox_ptr + 4 + current_offset;
+        
+        // 1. Write Direction
+        write_ptr[0] = direction;
+        
+        // 2. Write Type
+        write_ptr[1] = packet_type;
+        
+        // 3. Write 4-byte Length in Big-Endian (BE)
+        write_ptr[2] = (uint8_t)((len >> 24) & 0xFF);
+        write_ptr[3] = (uint8_t)((len >> 16) & 0xFF);
+        write_ptr[4] = (uint8_t)((len >> 8) & 0xFF);
+        write_ptr[5] = (uint8_t)(len & 0xFF);
+        
+        // 4. Append the payload
+        if (len > 0 && packet != nullptr) {
+            memcpy(write_ptr + 6, packet, len);
+        }
+        
+        // Update the global total bytes counter
+        *total_bytes_ptr += (6 + len);
+    }
+}
+
+// =========================================================================
+// PHASE 3: THE INJECTOR 
+// =========================================================================
+
+extern "C" size_t libafl_process(uint8_t* buf, size_t buf_len, size_t max_len) {
+    // 1. ACTION (INJECTION): Replace OpenThread's buffer with our mutated packet
+    if (g_input_index < g_input_queue.size()) {
+        const auto& packet = g_input_queue[g_input_index];
+        size_t copy_len = std::min(packet.size(), max_len);
+        memcpy(buf, packet.data(), copy_len);
+        
+        g_input_index++;
+        return copy_len;
+    } 
+
+    // If queue is empty, let the target use its original packet
+    return buf_len; 
+}
+
+// =========================================================================
+// THE OPENTHREAD TARGET
+// =========================================================================
+
+namespace ot {
+namespace Nexus {
+
+// Globals exposed to the external interception hooks
+size_t MaliciousNodeID_g = 0;
+size_t TargetNodeID_g = 0;
+bool AllNodesMalicious_g = false;
+
+void TestFormJoin(void)
+{
+    Core nexus;
+    Node &leader  = nexus.CreateNode();
+    Node &fed     = nexus.CreateNode();
+
+    // Assign roles for the external hooks to use
+#ifdef MALICIOUS_LEADER
+    MaliciousNodeID_g = leader.GetId(); // The Injector (Fuzzer)
+    TargetNodeID_g = fed.GetId(); // The Observer (Target)
+    AllNodesMalicious_g = false;
+#elif defined(MALICIOUS_FED)
+    MaliciousNodeID_g = fed.GetId(); // The Injector (Fuzzer)
+    TargetNodeID_g = leader.GetId(); // The Observer (Target)
+    AllNodesMalicious_g = false;
+#elif defined(MALICIOUS_BOTH)
+    #warning "Treating both nodes as malicious."
+    AllNodesMalicious_g = true;
+#else
+    #error "Please define one of MALICIOUS_LEADER, MALICIOUS_FED, or MALICIOUS_BOTH to specify which node(s) should be malicious."
+#endif
+
+    nexus.AdvanceTime(0);
+
+    leader.Form();
+    nexus.AdvanceTime(13 * 1000);
+
+    fed.Join(leader, Node::kAsFed);
+    nexus.AdvanceTime(5 * 1000);
+}
+
+} 
+} 
+
+// =========================================================================
+// LLVM LIBFUZZER API ENTRY POINTS
+// =========================================================================
+
+extern "C" int LLVMFuzzerInitialize(int *argc, char ***argv) {
+    setup_outbox();
+    return 0;
+}
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
+
+    thread_dissector::Reset();
+    srand(0U);
+
+    // CRITICAL: Reset the Outbox at the start of every single run!
+    if (g_outbox_ptr != nullptr) {
+        *((uint32_t*)g_outbox_ptr) = 0; 
+    }
+
+    // 1. Reset state 
+    g_input_queue.clear();
+    g_input_index = 0;
+
+    // 2. Parse the TLV format sequence
+    size_t cursor = 0;
+    // 1. Process the total length prefix (if enabled)
+    if constexpr (HAS_TOTAL_LEN_PREFIX) {
+        if (size < sizeof(TotalLenType)) {
+            return 0; // Payload too small to even contain the total length header
+        }
+        
+        TotalLenType expected_len = read_len<TotalLenType>(data);
+        size_t expected_size = static_cast<size_t>(expected_len) + sizeof(TotalLenType);
+        if (size != expected_size) {
+            std::cerr << "SIZE MISMATCH! Expected: " << expected_size << "; Got " << size << "" << std::endl;
+            return -1;
+        }
+        cursor += sizeof(TotalLenType);
+    }
+
+    // 2. Parse individual packets.
+    while (cursor + sizeof(PktLenType) <= size) {
+        PktLenType len = read_len<PktLenType>(&data[cursor]);
+        cursor += sizeof(PktLenType);
+
+        if (cursor + len <= size) {
+            // Ignore 0-byte payloads
+            if (len > 0) {
+                // Ensure the parsed packet does not exceed OpenThread's max frame size
+                size_t actual_len = std::min(static_cast<size_t>(len), static_cast<size_t>(OT_RADIO_FRAME_MAX_SIZE));
+                
+                // emplace_back is slightly more efficient than push_back here
+                g_input_queue.emplace_back(
+                    data + cursor, 
+                    data + cursor + actual_len
+                );
+            }
+            // Always advance by the original 'len' to keep TLV stream in sync for the next packet
+            cursor += len; 
+        } else {
+            break; // Truncated/corrupted payload, stop parsing safely
+        }
+    }
+
+    // 3. Execute the target sequence
+    ot::Nexus::TestFormJoin();
+
+    return 0;
+}
