new file mode 100644
index 000000000..fc2a710b6
--- /dev/null
+++ b/tests/nexus/platform/thread_dissector.hpp
@@ -0,0 +1,363 @@
+// thread_dissector.hpp
+//
+// Drop-in replacement for get_mle_packet_type() in the AFLNet adaptation
+// (tests/nexus/platform/nexus_core.cpp). Instead of returning 0xFF for every
+// frame that is not MLE, it parses the IEEE 802.15.4 / 6LoWPAN / UDP headers and
+// assigns distinct response codes to TMF (CoAP) requests and responses, MAC
+// frames, fragments and other UDP/ICMPv6 traffic.
+//
+// Code space (uint8_t, as expected by write_trace_to_outbox):
+//   0x00-0x3E  MLE command byte (as in the old dissector)
+//   0x3F       MLE with an out-of-range command byte
+//   0x40-0x7E  TMF request,  0x40 + index into kTmfUris
+//   0x7F       TMF request with an unknown URI
+//   0x80-0xBE  TMF response, 0x80 + index of the URI of the matching request
+//   0xBF       TMF response whose request was not seen
+//   0xC0       CoAP empty message (empty ACK / RST)
+//   0xC1       CoAP on a port other than 61631 (e.g. 5683)
+//   0xD0       DNS / mDNS / SRP (ports 53, 5353, 53535)
+//   0xD1       other UDP
+//   0xD8       ICMPv6
+//   0xD9       other IPv6 next header
+//   0xE0-0xE3  802.15.4 frame types other than data (beacon, ack, MAC command)
+//   0xE4       6LoWPAN subsequent fragment (FRAGN)
+//   0xE5       not IPHC (e.g. mutated dispatch byte)
+//   0xFF       truncated / unparsable
+//
+// Assumptions (fuzzing build of the patch): the MAC payload and the MLE payload
+// are not encrypted (see the FUZZING_BUILD_MODE changes in mac_frame.cpp and
+// mle.cpp), so the headers above are readable in the intercepted frame.
+
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace thread_dissector {
+
+// TMF URIs of OpenThread (src/core/thread/uri_paths.cpp). The order defines the
+// codes, so append new entries at the end only. At most 63 entries.
+static const char *const kTmfUris[] = {
+    "a/ae", "a/an", "a/aq", "a/ar", "a/as", "a/sd", "a/yl",            // address / server data
+    "b/ba", "b/bmr", "b/bq",                                         // backbone
+    "c/ab", "c/ag", "c/as", "c/ca", "c/cg", "c/cp", "c/cs", "c/da",  // MeshCoP
+    "c/dc", "c/es", "c/jf", "c/la", "c/lp", "c/pc", "c/pg", "c/pq",
+    "c/ps", "c/rx", "c/tx", "c/ur", "c/ut",
+    "d/da", "d/dg", "d/dq", "d/dr",                                  // diagnostics
+    "n/dn", "n/dr", "n/mr",                                          // DUA / MLR
+};
+static const size_t kNumTmfUris = sizeof(kTmfUris) / sizeof(kTmfUris[0]);
+
+enum : uint8_t {
+    kMleUnknown      = 0x3F,
+    kTmfReqBase      = 0x40,
+    kTmfReqUnknown   = 0x7F,
+    kTmfRspBase      = 0x80,
+    kTmfRspUnmatched = 0xBF,
+    kCoapEmpty       = 0xC0,
+    kCoapOtherPort   = 0xC1,
+    kDns             = 0xD0,
+    kUdpOther        = 0xD1,
+    kIcmp6           = 0xD8,
+    kIpOther         = 0xD9,
+    kMacBeacon       = 0xE0,
+    kMacAck          = 0xE2,
+    kMacCommand      = 0xE3,
+    kFragN           = 0xE4,
+    kNotIphc         = 0xE5,
+    kUnknown         = 0xFF,
+};
+
+static const uint16_t kMlePort = 19788;
+static const uint16_t kTmfPort = 61631;
+
+// Token -> URI table, so that a CoAP response is mapped to the URI of its
+// request. Small ring buffer, call Reset() at the start of every execution
+// (LLVMFuzzerTestOneInput), otherwise stale entries only cause a few
+// mismatches.
+struct TokenEntry {
+    uint8_t len;
+    uint8_t token[8];
+    uint8_t uriIndex;
+};
+static TokenEntry sTokens[32];
+static size_t     sNextToken = 0;
+
+inline void Reset(void)
+{
+    memset(sTokens, 0, sizeof(sTokens));
+    sNextToken = 0;
+}
+
+inline void RememberToken(const uint8_t *aToken, uint8_t aLen, uint8_t aUriIndex)
+{
+    if (aLen == 0 || aLen > 8) return;
+    TokenEntry &e = sTokens[sNextToken++ % (sizeof(sTokens) / sizeof(sTokens[0]))];
+    e.len         = aLen;
+    memcpy(e.token, aToken, aLen);
+    e.uriIndex = aUriIndex;
+}
+
+inline int LookupToken(const uint8_t *aToken, uint8_t aLen)
+{
+    for (const TokenEntry &e : sTokens)
+    {
+        if (e.len != 0 && e.len == aLen && memcmp(e.token, aToken, aLen) == 0) return e.uriIndex;
+    }
+    return -1;
+}
+
+// ---------------------------------------------------------------------------
+// CoAP (RFC 7252) on the TMF port
+// ---------------------------------------------------------------------------
+inline uint8_t ClassifyCoap(const uint8_t *p, size_t len, bool aIsTmfPort)
+{
+    if (len < 4 || (p[0] >> 6) != 1) return kUnknown;
+    if (!aIsTmfPort) return kCoapOtherPort;
+
+    uint8_t tkl  = p[0] & 0x0F;
+    uint8_t code = p[1];
+    if (tkl > 8 || 4 + (size_t)tkl > len) return kUnknown;
+    const uint8_t *token = p + 4;
+
+    if (code == 0) return kCoapEmpty;
+
+    bool isRequest = (code >> 5) == 0; // class 0: 0.01 GET .. 0.04 DELETE
+
+    if (!isRequest)
+    {
+        int idx = LookupToken(token, tkl);
+        if (idx < 0) return kTmfRspUnmatched;
+        return (uint8_t)(kTmfRspBase + idx);
+    }
+
+    // Assemble the Uri-Path (option 11) segments as "a/sd".
+    char   uri[32];
+    size_t uriLen = 0;
+    size_t i      = 4 + tkl;
+    unsigned opt  = 0;
+
+    while (i < len && p[i] != 0xFF)
+    {
+        unsigned delta = p[i] >> 4, olen = p[i] & 0x0F;
+        i++;
+        if (delta == 13) { if (i >= len) break; delta = 13 + p[i++]; }
+        else if (delta == 14) { if (i + 1 >= len) break; delta = 269 + ((p[i] << 8) | p[i + 1]); i += 2; }
+        else if (delta == 15) break;
+        if (olen == 13) { if (i >= len) break; olen = 13 + p[i++]; }
+        else if (olen == 14) { if (i + 1 >= len) break; olen = 269 + ((p[i] << 8) | p[i + 1]); i += 2; }
+        else if (olen == 15) break;
+        if (i + olen > len) break;
+
+        opt += delta;
+        if (opt == 11) // Uri-Path
+        {
+            if (uriLen != 0 && uriLen < sizeof(uri) - 1) uri[uriLen++] = '/';
+            for (unsigned k = 0; k < olen && uriLen < sizeof(uri) - 1; k++) uri[uriLen++] = (char)p[i + k];
+        }
+        else if (opt > 11) break; // options are ordered, Uri-Path is done
+        i += olen;
+    }
+    uri[uriLen] = '\0';
+
+    for (size_t u = 0; u < kNumTmfUris && u < 63; u++)
+    {
+        if (strcmp(uri, kTmfUris[u]) == 0)
+        {
+            RememberToken(token, tkl, (uint8_t)u);
+            return (uint8_t)(kTmfReqBase + u);
+        }
+    }
+    return kTmfReqUnknown;
+}
+
+// ---------------------------------------------------------------------------
+// MLE (Thread spec, UDP 19788)
+// ---------------------------------------------------------------------------
+inline uint8_t ClassifyMle(const uint8_t *p, size_t len)
+{
+    if (len < 1) return kUnknown;
+    size_t i = 0;
+    if (p[0] == 0xFF) // unsecured (Discovery Request / Response)
+    {
+        i = 1;
+    }
+    else if (p[0] == 0x00) // secured: aux security header follows
+    {
+        if (len < 2) return kUnknown;
+        uint8_t sc = p[1];
+        i          = 2;
+        if (!((sc >> 5) & 1)) i += 4; // frame counter (not suppressed)
+        static const size_t kKeyIdLen[4] = {0, 1, 5, 9};
+        i += kKeyIdLen[(sc >> 3) & 3];
+    }
+    else
+    {
+        return kUnknown;
+    }
+    if (i >= len) return kUnknown;
+    // MLE commands are below 0x20. Mutated, out-of-range values share one code
+    // instead of aliasing onto real commands.
+    if (p[i] >= 0x3F) return kMleUnknown;
+    return p[i];
+}
+
+inline uint8_t ClassifyUdp(uint16_t aSrc, uint16_t aDst, const uint8_t *aPayload, size_t aLen)
+{
+    if (aSrc == kMlePort || aDst == kMlePort) return ClassifyMle(aPayload, aLen);
+    if (aSrc == kTmfPort || aDst == kTmfPort) return ClassifyCoap(aPayload, aLen, true);
+    if (aSrc == 5683 || aDst == 5683) return ClassifyCoap(aPayload, aLen, false);
+    if (aSrc == 53 || aDst == 53 || aSrc == 5353 || aDst == 5353 || aSrc == 53535 || aDst == 53535) return kDns;
+    return kUdpOther;
+}
+
+// ---------------------------------------------------------------------------
+// IEEE 802.15.4 + 6LoWPAN (RFC 4944 / 6282)
+// ---------------------------------------------------------------------------
+inline uint8_t GetPacketType(const uint8_t *p, size_t len)
+{
+    if (p == nullptr || len < 3) return kUnknown;
+
+#define NEED(n)                      \
+    do                               \
+    {                                \
+        if (i + (n) > len) return kUnknown; \
+    } while (0)
+
+    uint16_t fcf     = (uint16_t)(p[0] | (p[1] << 8));
+    uint8_t  ftype   = fcf & 7;
+    bool     sec     = (fcf >> 3) & 1;
+    bool     panComp = (fcf >> 6) & 1;
+    uint8_t  dstMode = (fcf >> 10) & 3;
+    uint8_t  srcMode = (fcf >> 14) & 3;
+
+    switch (ftype)
+    {
+    case 0: return kMacBeacon;
+    case 1: break;
+    case 2: return kMacAck;
+    case 3: return kMacCommand;
+    default: return kUnknown;
+    }
+
+    static const size_t kAddrLen[4] = {0, 0, 2, 8};
+    size_t              i           = 3; // FCF + sequence number
+    if (dstMode) i += 2 + kAddrLen[dstMode];
+    if (srcMode)
+    {
+        if (!panComp) i += 2;
+        i += kAddrLen[srcMode];
+    }
+    if (sec)
+    {
+        NEED(1);
+        uint8_t sc = p[i++];
+        if (!((sc >> 5) & 1)) i += 4;
+        static const size_t kKeyIdLen[4] = {0, 1, 5, 9};
+        i += kKeyIdLen[(sc >> 3) & 3];
+    }
+
+    // Note: the MIC / FCS at the end of the frame is not stripped. This only
+    // matters for payload lengths, which are not used beyond bounds checks.
+
+    NEED(1);
+    uint8_t d = p[i];
+    if ((d >> 6) == 2) // mesh header
+    {
+        bool v = (d >> 5) & 1, f = (d >> 4) & 1;
+        i += 1 + (v ? 2 : 8) + (f ? 2 : 8);
+        NEED(1);
+        d = p[i];
+    }
+    if ((d >> 3) == 0x18) // FRAG1: headers follow
+    {
+        i += 4;
+        NEED(1);
+        d = p[i];
+    }
+    else if ((d >> 3) == 0x1C) // FRAGN: no headers
+    {
+        return kFragN;
+    }
+    if ((d >> 5) != 0x3) return kNotIphc;
+
+    NEED(2);
+    uint8_t b0 = p[i], b1 = p[i + 1];
+    i += 2;
+    uint8_t tf = (b0 >> 3) & 3, hlim = b0 & 3;
+    bool    nh  = (b0 >> 2) & 1;
+    bool    cid = (b1 >> 7) & 1, sac = (b1 >> 6) & 1, m = (b1 >> 3) & 1, dac = (b1 >> 2) & 1;
+    uint8_t sam = (b1 >> 4) & 3, dam = b1 & 3;
+
+    static const size_t kTf[4]       = {4, 3, 1, 0};
+    static const size_t kAddrU[4]    = {16, 8, 2, 0};   // stateless
+    static const size_t kAddrC[4]    = {0, 8, 2, 0};    // context based
+    static const size_t kMcastU[4]   = {16, 6, 4, 1};   // multicast stateless
+    static const size_t kMcastC[4]   = {6, 0, 0, 0};    // multicast context based
+
+    if (cid) i += 1;
+    i += kTf[tf];
+    uint8_t nextHeader = 0;
+    if (!nh)
+    {
+        NEED(1);
+        nextHeader = p[i++];
+    }
+    if (hlim == 0) i += 1;
+    i += sac ? kAddrC[sam] : kAddrU[sam];
+    if (!m) i += dac ? kAddrC[dam] : kAddrU[dam];
+    else i += dac ? kMcastC[dam] : kMcastU[dam];
+
+    uint16_t src = 0, dst = 0;
+
+    if (nh)
+    {
+        NEED(1);
+        uint8_t n = p[i];
+        // IPv6 extension headers compressed with NHC (e.g. hop-by-hop for MPL)
+        while ((n >> 4) == 0xE)
+        {
+            bool nhBit = n & 1;
+            i += 1;
+            if (!nhBit)
+            {
+                NEED(1);
+                nextHeader = p[i++];
+            }
+            NEED(1);
+            i += 1 + p[i];
+            if (!nhBit) goto inline_next_header;
+            NEED(1);
+            n = p[i];
+        }
+        if ((n >> 3) != 0x1E) return kIpOther; // not NHC UDP
+        {
+            uint8_t ports = n & 3;
+            bool    cElided = (n >> 2) & 1;
+            i += 1;
+            switch (ports)
+            {
+            case 0: NEED(4); src = (p[i] << 8) | p[i + 1]; dst = (p[i + 2] << 8) | p[i + 3]; i += 4; break;
+            case 1: NEED(3); src = (p[i] << 8) | p[i + 1]; dst = 0xF000 | p[i + 2]; i += 3; break;
+            case 2: NEED(3); src = 0xF000 | p[i]; dst = (p[i + 1] << 8) | p[i + 2]; i += 3; break;
+            default: NEED(1); src = 0xF0B0 | (p[i] >> 4); dst = 0xF0B0 | (p[i] & 0xF); i += 1; break;
+            }
+            if (!cElided) i += 2;
+            if (i > len) return kUnknown;
+            return ClassifyUdp(src, dst, p + i, len - i);
+        }
+    }
+
+inline_next_header:
+    if (nextHeader == 58) return kIcmp6;
+    if (nextHeader != 17) return kIpOther;
+    NEED(8); // uncompressed UDP header
+    src = (p[i] << 8) | p[i + 1];
+    dst = (p[i + 2] << 8) | p[i + 3];
+    i += 8;
+    return ClassifyUdp(src, dst, p + i, len - i);
+
+#undef NEED
+}
+
+} // namespace thread_dissector
