+ns3::Ptr<ns3::Packet> ProcessFuzzerTx(ns3::Ptr<ns3::Packet> packet, uint8_t DIRECTION, uint8_t packet_type, uint32_t max_len)
+{
+    // 1. Mutate the packet
+    packet = MutatePacketWithFuzzer(packet, max_len);
+    
+    // 2. Extract the fuzzed bytes
+    uint32_t fuzzed_len = packet->GetSize();
+    std::vector<uint8_t> fuzzed_buf(fuzzed_len);
+    packet->CopyData(fuzzed_buf.data(), fuzzed_len);
+    
+    // 3. Write to outbox
+    write_trace_to_outbox(DIRECTION, packet_type /* Non-fuzzed packet type. Serves as a feedback for AFLNet */, fuzzed_buf.data(), fuzzed_len);
+    
+    return packet;
