--- a/src/lte/model/lte-rrc-protocol-real.cc
+++ b/src/lte/model/lte-rrc-protocol-real.cc
@@ -22,9 +22,154 @@
 #include "ns3/nstime.h"
 #include "ns3/simulator.h"
 
+#include <algorithm>
+#include <vector>
+#include <iostream>
+
+#ifdef FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
+// bool malicious_enb_g = false;
+// bool malicious_ue_g = false;
+
+std::vector<std::vector<uint8_t>> g_input_queue;
+size_t g_input_index = 0;
+uint8_t* g_outbox_ptr = nullptr;
+const size_t OUTBOX_CAPACITY = 1024 * 1024;
+#endif
+
 namespace ns3
 {
 
+#ifdef FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
+
+#define DIR_UPLINK  0x00
+#define DIR_DOWNLINK 0x01
+
+enum LteRrcFuzzPacketType : uint8_t {
+    LTE_RRC_CONN_REQ               = 0x01,
+    LTE_RRC_CONN_SETUP             = 0x02,
+    LTE_RRC_CONN_SETUP_COMPLETE    = 0x03,
+    LTE_RRC_CONN_REJECT            = 0x04,
+    LTE_RRC_CONN_RECONF            = 0x05,
+    LTE_RRC_CONN_RECONF_COMPLETE   = 0x06,
+    LTE_RRC_CONN_REEST_REQ         = 0x07,
+    LTE_RRC_CONN_REEST             = 0x08,
+    LTE_RRC_CONN_REEST_COMPLETE    = 0x09,
+    LTE_RRC_CONN_REEST_REJECT      = 0x0A,
+    LTE_RRC_MEAS_REPORT            = 0x0B
+};
+
+size_t process_packet(uint8_t* buf, size_t buf_len, size_t max_len) {
+    if (g_input_index < g_input_queue.size()) {
+        std::cout << "[FUZZING!]" << std::endl;
+        const auto& packet = g_input_queue[g_input_index];
+        size_t copy_len = std::min(packet.size(), max_len);
+        memcpy(buf, packet.data(), copy_len);
+        
+        g_input_index++;
+        return copy_len;
+    } else {
+        std::cout << "[UNCHANGED!]" << std::endl;
+    }
+    return buf_len;
+}
+
+void write_trace_to_outbox(uint8_t direction, uint8_t packet_type, const uint8_t* packet, size_t len) {
+    if (!g_outbox_ptr) {
+        return;
+    }
+
+    uint32_t* total_bytes_ptr = (uint32_t*)g_outbox_ptr;
+    uint32_t current_offset = *total_bytes_ptr;
+
+    // Header size is now 6 bytes: [1b Dir] + [1b Type] + [4b Length]
+    if (4 + current_offset + 6 + len <= OUTBOX_CAPACITY) {
+        uint8_t* write_ptr = g_outbox_ptr + 4 + current_offset;
+        
+        // 1. Write Direction
+        write_ptr[0] = direction;
+        
+        // 2. Write Type
+        write_ptr[1] = packet_type;
+        
+        // 3. Write 4-byte Length in Big-Endian (BE)
+        write_ptr[2] = (uint8_t)((len >> 24) & 0xFF);
+        write_ptr[3] = (uint8_t)((len >> 16) & 0xFF);
+        write_ptr[4] = (uint8_t)((len >> 8) & 0xFF);
+        write_ptr[5] = (uint8_t)(len & 0xFF);
+        
+        // 4. Append the payload
+        if (len > 0 && packet != nullptr) {
+            memcpy(write_ptr + 6, packet, len);
+        }
+        
+        // Update the global total bytes counter
+        *total_bytes_ptr += (6 + len);
+    }
+}
+
+ns3::Ptr<ns3::Packet> MutatePacketWithFuzzer(ns3::Ptr<ns3::Packet> originalPacket, uint32_t max_len)
+{
+    uint32_t payloadSize = originalPacket->GetSize();
+    
+    // 1. Allocate a buffer large enough for both the original packet and potential mutations
+    std::vector<uint8_t> buffer(max_len, 0);
+
+    // 2. Extract the serialized bytes (safely capped to max_len to prevent overflows)
+    uint32_t copySize = std::min(payloadSize, max_len);
+    originalPacket->CopyData(buffer.data(), copySize);
+
+    // 3. Run your interception template
+    uint32_t new_len = process_packet(buffer.data(), copySize, max_len);
+
+    // 4. Return a brand new packet containing the fuzzer's bytes
+    return ns3::Create<ns3::Packet>(buffer.data(), new_len);
+}
