index 000000000..d6b4a69d3
--- /dev/null
+++ b/fuzz/minimal_lte_fuzz.cc
@@ -0,0 +1,128 @@
+#include "ns3/core-module.h"
+#include "ns3/network-module.h"
+#include "ns3/internet-module.h"
+#include "ns3/mobility-module.h"
+#include "ns3/lte-module.h"
+#include "ns3/point-to-point-module.h"
+#include <iostream>
+
+#include "InterceptFuzz/InterceptFuzz.hpp"
+
+using namespace ns3;
+
+// =========================================================================
+// TRACE CALLBACKS (Stop simulation immediately on attach outcome)
+// =========================================================================
+
+void NotifyConnectionEstablished(uint64_t imsi, uint16_t cellId, uint16_t rnti)
+{
+    std::cout << "\n======================================================\n";
+    std::cout << "[UE IMSI: " << imsi << "] Attach Procedure Complete!\n";
+    std::cout << "RRC Connection Established at: " << Simulator::Now().GetMilliSeconds() << " ms\n";
+    std::cout << "Halting simulation to prevent further traffic.\n";
+    std::cout << "======================================================\n\n";
+    
+    // Instantly halts the simulation clock
+    Simulator::Stop(); 
+}
+
+void NotifyConnectionTimeout(uint64_t imsi, uint16_t cellId, uint16_t rnti, uint8_t connEstFailCount)
+{
+    std::cout << "\n======================================================\n";
+    std::cout << "[UE IMSI: " << imsi << "] Attach FAILED! (Timeout / Max Retries reached)\n";
+    std::cout << "Failed at: " << Simulator::Now().GetMilliSeconds() << " ms\n";
+    std::cout << "Halting simulation early.\n";
+    std::cout << "======================================================\n\n";
+    
+    // Instantly halts the simulation clock
+    Simulator::Stop(); 
+}
+
+// =========================================================================
+// MAIN SIMULATION
+// =========================================================================
+// extern bool malicious_enb_g;
+// extern bool malicious_ue_g;
+
+int test_lte_attach()
+{
+    // CommandLine cmd(__FILE__);
+    // cmd.Parse(argc, argv);
+
+    // 1. Create nodes: one UE (Phone) and one eNodeB (Base Station)
+    NodeContainer ueNodes;
+    ueNodes.Create(1);
+
+    NodeContainer enbNodes;
+    enbNodes.Create(1);
+
+// #if defined(MALICIOUS_ENB)
+//     malicious_enb_g = true;
+// #elif defined(MALICIOUS_UE)
+//     malicious_ue_g = true;
+// #else
+// #error "You must define either MALICIOUS_ENB or MALICIOUS_UE during compilation"
+// #endif
+
+    // 2. Set up the LTE and EPC (Core Network) helpers
+    Ptr<LteHelper> lteHelper = CreateObject<LteHelper>();
+    lteHelper->SetAttribute("UseIdealRrc", BooleanValue(false));
+    Ptr<PointToPointEpcHelper> epcHelper = CreateObject<PointToPointEpcHelper>();
+    lteHelper->SetEpcHelper(epcHelper);
+
+    // 3. Set physical positions
+    MobilityHelper mobility;
+    mobility.SetMobilityModel("ns3::ConstantPositionMobilityModel");
+    mobility.Install(enbNodes);
+    mobility.Install(ueNodes);
+
+    // 4. Install LTE radio devices
+    NetDeviceContainer enbLteDevs = lteHelper->InstallEnbDevice(enbNodes);
+    NetDeviceContainer ueLteDevs = lteHelper->InstallUeDevice(ueNodes);
+
+    // 5. Install the Internet stack on the UE 
+    InternetStackHelper internet;
+    internet.Install(ueNodes);
+
+    // 6. Assign IP addresses and routing
+    Ipv4InterfaceContainer ueIpIface = epcHelper->AssignUeIpv4Address(NetDeviceContainer(ueLteDevs));
+    
+    Ipv4StaticRoutingHelper ipv4RoutingHelper;
+    // FIXED: Removed the ->GetRoutingProtocol() call
+    Ptr<Ipv4StaticRouting> ueStaticRouting = ipv4RoutingHelper.GetStaticRouting(ueNodes.Get(0)->GetObject<Ipv4>());
+    ueStaticRouting->SetDefaultRoute(epcHelper->GetUeDefaultGatewayAddress(), 1);
+
+    // 7. Hook our custom callbacks into the UE's RRC state machine
+    Config::ConnectWithoutContext(
+        "/NodeList/*/DeviceList/*/$ns3::LteUeNetDevice/LteUeRrc/ConnectionEstablished",
+        MakeCallback(&NotifyConnectionEstablished)
+    );
+
+    Config::ConnectWithoutContext(
+        "/NodeList/*/DeviceList/*/$ns3::LteUeNetDevice/LteUeRrc/ConnectionTimeout",
+        MakeCallback(&NotifyConnectionTimeout)
+    );
+
+    // 8. Initiate the Attach Procedure
+    lteHelper->Attach(ueLteDevs, enbLteDevs.Get(0));
+
+    // 9. Fail-safe timeout (In case the state machine hangs elsewhere, cap it at 1 second)
+    Simulator::Stop(MilliSeconds(500));
+    
+    Simulator::Run();
+    Simulator::Destroy();
+
+    return 0;
+}
+
+INTERCEPTFUZZ_TEST(Scenario)
+{
+    // are identical for every execution path.
+    ns3::RngSeedManager::SetSeed(12345);
+    ns3::RngSeedManager::SetRun(1);
+
+    // 2. Disable unnecessary console logging (optional, but speeds up fuzzing)
+    ns3::LogComponentDisableAll(ns3::LOG_LEVEL_ALL);
+
+    test_lte_attach();
+}
