+// --- DEBUG HEX PRINTER HELPER ---
+static void PrintHexBuffer(const std::string& label, const uint8_t* buffer, uint32_t size)
+{
+    std::cout << "--- " << label << " (" << size << " bytes) ---\n";
+    if (size == 0)
+    {
+        std::cout << "(Empty)\n";
+        return;
+    }
+    for (uint32_t i = 0; i < size; i++) {
+        printf("%02x ", buffer[i]);
+        if ((i + 1) % 16 == 0) std::cout << "\n";
+    }
+    if (size % 16 != 0) std::cout << "\n";
+}
+// --------------------------------
+
 TypeId
 WifiMacQueue::GetTypeId()
 {
@@ -222,7 +241,61 @@ bool
 WifiMacQueue::Enqueue(Ptr<WifiMpdu> item)
 {
     NS_LOG_FUNCTION(this << *item);
+    // 1. Extract the separated Header and Payload
+    const WifiMacHeader& macHeader = item->GetHeader();
+    Ptr<const Packet> payload = item->GetPacket();
+
+    uint32_t senderNodeId = Simulator::GetContext();
+
+    // std::cout << "\n=================================================\n";
+    // std::cout << "[MAC QUEUE] Packet Intercepted\n";
 
+    // 2. Serialize and Print the MAC Header (The part you will KEEP)
+    uint32_t headerSize = macHeader.GetSerializedSize();
+    if (headerSize > 0)
+    {
+        Buffer headerBuffer;
+        headerBuffer.AddAtStart(headerSize);
+        macHeader.Serialize(headerBuffer.Begin());
+        
+        // uint8_t* hBytes = new uint8_t[headerSize];
+        // headerBuffer.CopyData(hBytes, headerSize);
+        // PrintHexBuffer("MAC Header", hBytes, headerSize);
+        // delete[] hBytes;
+    }
+
+    // // 3. Print the Original Payload 
+    uint32_t payloadSize = payload->GetSize();
+    
+    std::cout << "Sender ID: " << senderNodeId << std::endl;
+    if (payloadSize > 0)
+    {
+        uint8_t* pBytes = new uint8_t[payloadSize];
+        payload->CopyData(pBytes, payloadSize);
+        PrintHexBuffer("Original Payload", pBytes, payloadSize);
+        delete[] pBytes;
+    }
+    // else 
+    // {
+    //     std::cout << "(Empty Payload)\n";
+    // }
+    // std::cout << "=================================================\n";
+
+    // --- 4. YOUR UNIVERSAL FUZZER INJECTION ---
+    // We only attempt to fuzz if there is an actual payload to mutate.
+    // Frames like pure ACKs or CTS have 0 payload size.
+    //if (senderNodeId == malicious_node_id_g && payloadSize > 0)
+    if (payloadSize > 0)
+    {
+        std::cout << "\n[FUZZER] Packet with payload detected! Passing to fuzz()...\n";
+
+        std::vector<uint8_t> bytes(payloadSize);
+        payload->CopyData(bytes.data(), payloadSize);
+        std::vector<uint8_t> fuzzed = InterceptFuzz::intercept_copy(bytes.data(), payloadSize, 1500); // Wi-Fi MTU
+
+        // Same MAC header, fuzzed payload
+        item = Create<WifiMpdu>(Create<Packet>(fuzzed.data(), fuzzed.size()), macHeader);
+    }
     auto queueId = WifiMacQueueContainer::GetQueueId(item);
     return Insert(GetContainer().GetQueue(queueId).cend(), item);
 }
