+// Hands the bytes of an RRC message to InterceptFuzz and wraps the result in a new packet.
+static Ptr<Packet>
+MutatePacketWithFuzzer(Ptr<Packet> packet, uint32_t max_len)
+{
+    std::vector<uint8_t> bytes(packet->GetSize());
+    packet->CopyData(bytes.data(), bytes.size());
+    std::vector<uint8_t> fuzzed = InterceptFuzz::intercept_copy(bytes.data(), bytes.size(), max_len);
+    return Create<Packet>(fuzzed.data(), fuzzed.size());
+}
