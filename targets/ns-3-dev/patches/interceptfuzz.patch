+
+#include "InterceptFuzz/InterceptFuzz.hpp"
+
+using namespace ns3;
+
+// extern uint32_t malicious_node_id_g;
+
+int test_wifi_attach()
+{
+    // CommandLine cmd(__FILE__);
+    // cmd.Parse(argc, argv);
+    // 1. Create exactly two nodes
+    NodeContainer wifiStaNode;
+    wifiStaNode.Create(1);
+    NodeContainer wifiApNode;
+    wifiApNode.Create(1);
+
+// #if defined(MALICIOUS_STA)
+//     malicious_node_id_g = wifiStaNode.Get(0)->GetId();
+// #elif defined(MALICIOUS_AP)
+//     malicious_node_id_g = wifiApNode.Get(0)->GetId();
+// #else
+// #error "You must define either MALICIOUS_STA or MALICIOUS_AP during compilation"
+// #endif
+
+    // 2. Set up the physical Wi-Fi channel
+    YansWifiChannelHelper channel = YansWifiChannelHelper::Default();
+    YansWifiPhyHelper phy;
+    phy.SetChannel(channel.Create());
+
+    // 3. Configure the MAC layer and SSID
+    WifiHelper wifi;
+    WifiMacHelper mac;
+    Ssid ssid = Ssid("fuzz-target");
+
+    // Configure the Station (Client)
+    mac.SetType("ns3::StaWifiMac",
+                "Ssid", SsidValue(ssid),
+                "ActiveProbing", BooleanValue(true)); // Forces Probe Requests
+    NetDeviceContainer staDevice = wifi.Install(phy, mac, wifiStaNode);
+
+    // Configure the Access Point (Router)
+    mac.SetType("ns3::ApWifiMac",
+                "Ssid", SsidValue(ssid));
+    NetDeviceContainer apDevice = wifi.Install(phy, mac, wifiApNode);
+
+    // 4. Set physical positions (Wi-Fi requires this to calculate signal strength)
+    MobilityHelper mobility;
+    mobility.SetMobilityModel("ns3::ConstantPositionMobilityModel");
+    mobility.Install(wifiApNode);
+    mobility.Install(wifiStaNode);
+
+    // 5. Install the Internet stack (IP addresses)
+    InternetStackHelper stack;
+    stack.Install(wifiApNode);
+    stack.Install(wifiStaNode);
+
+    Ipv4AddressHelper address;
+    address.SetBase("192.168.1.0", "255.255.255.0");
+    address.Assign(apDevice);
+    address.Assign(staDevice);
+
+    // 6. Enable PCAP tracing directly on the Access Point
+    // phy.SetPcapDataLinkType(WifiPhyHelper::DLT_IEEE802_11_RADIO);
+    // phy.EnablePcap("minimal-wifi-attach", apDevice.Get(0));
+
+    // 7. Run for just X ms.
+    Simulator::Stop(MilliSeconds(300));
+    Simulator::Run();
+    Simulator::Destroy();
+
+    return 0;
+}
+
+INTERCEPTFUZZ_TEST(Scenario)
+{
+    // are identical for every execution path.
+    ns3::RngSeedManager::SetSeed(12345);
+    ns3::RngSeedManager::SetRun(1);
+
+    // 2. Disable unnecessary console logging (optional, but speeds up fuzzing)
+    ns3::LogComponentDisableAll(ns3::LOG_LEVEL_ALL);
+
+    test_wifi_attach();
+}
